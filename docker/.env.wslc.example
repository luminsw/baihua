# 百花 · wslc 形态配置模板（复制为 docker/.env.wslc 后按需修改）
# 注意：真实 .env.wslc 含 PG 密码，已在 .gitignore，切勿提交。
# 首次 bh start 会自动生成该文件（含随机 PG_PASSWORD），通常不需要手工创建。

# 公共镜像加速源
BAIHUA_WSL_MIRROR=docker.m.daocloud.io

# PostgreSQL
PG_USER=baihua
PG_DATABASE=baihua
PG_HOST_PORT=5433
# 留空则由 bh 首次启动时随机生成
PG_PASSWORD=

# 宿主端口
BAIHUA_SERVER_PORT=8788
BAIHUA_WEBUI_PORT=5177
# 宿主 :80 被占用时可改成 8080 等
BAIHUA_NGINX_PORT=80

# 知识库笔记根目录（Windows 路径，容器内映射为 /vaults）
VAULTS_DIR=C:/Users/你的用户名/Vaults

# 容器访问宿主 OVMS 的地址；留空则由 bh 自动探测（OVMS 为容器时用固定容器名）
OVMS_HOST_IP=

# 镜像来源：
#   auto     = 仓库内有源码则本地构建（开发者）；瘦部署包无源码则从 registry 拉取
#   local    = 只本地构建（需要源码 + .NET SDK）
#   registry = 只从 registry 拉取（最终用户部署包）
BAIHUA_IMAGE_SOURCE=auto
BAIHUA_IMAGE_NAMESPACE=luminsw
BAIHUA_IMAGE_TAG=latest
# 自己镜像的 registry（最终用户部署包必须能匿名拉取）：
#   默认 SWR：swr.cn-north-4.myhuaweicloud.com（国内匿名拉取已验证；镜像需保持公开）
#   阿里云 ACR：crpi-<实例ID>.cn-hangzhou.personal.cr.aliyuncs.com（仓库需公开）
#   留空 = Docker Hub 直连（国内常超时，不推荐）
#   （daocloud 镜像站只代理白名单内的公共镜像，不能用于个人仓库）
BAIHUA_IMAGE_REGISTRY=swr.cn-north-4.myhuaweicloud.com