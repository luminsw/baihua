# ============================================
# 百花 Docker 部署环境变量模板
# 复制为 .env 后按需填写：cp .env.example .env
# ============================================

# 知识库根路径（宿主机实际路径，最终用户需改为自己的路径）
VAULTS_DIR=/home/lumin/Vaults

# ────────────────────────────────────────────────
# PostgreSQL（单一数据库：整个百花只有一个库）
# ────────────────────────────────────────────────

# 数据库密码（必填）：缺失时 docker compose 直接报错，不启动。
PG_PASSWORD=

# 数据库名/用户（默认 baihua；先用 scripts/migrate-to-single-db.ps1 迁移旧三库）
PG_DATABASE=baihua
PG_USER=baihua

# ────────────────────────────────────────────────
# Nginx 统一入口（默认启用并监听 80）
# ────────────────────────────────────────────────

# Nginx 对外监听端口。
#   80     → 默认，浏览器输入 http://<ip> 即可
#   8080   → 运营商封 80 时用
BAIHUA_NGINX_PORT=80

# WebUI 路径前缀（空=挂根路径，推荐）。
# 如已有反代占用 80，可填 /baihua 让 WebUI 挂在子路径下。
# 花记移动端的 /mg/* 等前缀不受此变量影响。
BAIHUA_WEBUI_PREFIX=

# Blazor 静态资源强缓存开关（默认 true，开发调试可关）
BAIHUA_WEBUI_STATIC_CACHE=true

# 上传文件最大体积（知识库附件、头像上传等）
BAIHUA_NGINX_CLIENT_MAX_BODY_SIZE=100M

# Nginx 日志/数据根目录（与 .NET 日志同根）
BAIHUA_HOME=/opt/baihua

# ────────────────────────────────────────────────
# OpenObserve（可观测性，profile: observability，可选）
# ────────────────────────────────────────────────

# OpenObserve 管理员密码（必填）：缺失时 docker compose 直接报错，不启动。
# 例：cp .env.example .env 后执行
#   OPENOBSERVE_PASSWORD=your-strong-password docker compose --profile observability up -d openobserve
OPENOBSERVE_PASSWORD=
