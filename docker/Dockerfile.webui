# WebUI.Family - 百花家庭版管理后台（Blazor Server）
# 基于预构建的基础镜像，加速构建过程
#
# 首次构建前需要先构建基础镜像：
#   docker build -f Dockerfile.base-build -t bh/base-build:latest ..
#   docker build -f Dockerfile.base-runtime -t bh/base-runtime:latest ..

# ==================== Build 阶段 ====================
FROM bh/base-build:latest AS build
WORKDIR /src

# 先复制项目文件以利用 Docker 缓存层
COPY services/Baihua.Contracts/Baihua.Contracts.csproj services/Baihua.Contracts/
COPY services/Baihua.Web/Baihua.Web.csproj services/Baihua.Web/
RUN dotnet restore services/Baihua.Web/Baihua.Web.csproj

# 复制全部源码并发布
COPY services/ services/
# 清理宿主机可能带入的 bin/obj 缓存，确保 dotnet publish 完整生成所有文件（包括 _framework）
RUN find /src/services -type d -name bin -exec rm -rf {} + 2>/dev/null; \
    find /src/services -type d -name obj -exec rm -rf {} + 2>/dev/null; \
    dotnet restore services/Baihua.Web/Baihua.Web.csproj && \
    dotnet publish services/Baihua.Web/Baihua.Web.csproj \
    -c Release -o /app/publish

# ==================== Runtime 阶段 ====================
FROM bh/base-runtime:latest AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
LABEL git.commit=$GIT_COMMIT
LABEL git.branch=$GIT_BRANCH

EXPOSE 5177

ENV ASPNETCORE_URLS=http://0.0.0.0:5177
ENV WEBUI_CONFIG_DIR=/app/data
# 后端已合并为单一服务 Baihua.Server（8788）：WebUI 只需一个后端地址；
# docker compose 里用服务名 server 覆盖（BaihuaServer__BaseUrl=http://server:8788/）
ENV BaihuaServer__BaseUrl=http://127.0.0.1:8788/

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5177/ || exit 1

ENTRYPOINT ["dotnet", "bh-webui.dll"]
