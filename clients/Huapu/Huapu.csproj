<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Android: .NET 10（API 36.1，本机已装平台） -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android36.1;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('osx'))">net10.0-android36.1</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobileApp.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <MauiBlazor>true</MauiBlazor>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Android: .so 文件必须不压缩存储；真机 Debug 测试关闭 Fast Deployment，避免增量安装压�?native lib 导致启动崩溃 -->
    <AndroidStoreUncompressedFileExtensions>.so;.dll</AndroidStoreUncompressedFileExtensions>
    <AndroidEnableCompressionInNativeLibraries>false</AndroidEnableCompressionInNativeLibraries>
    <AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <ApplicationTitle>花圃</ApplicationTitle>
    <ApplicationId>com.lumin.baihua</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

    <!-- iOS (.NET 10) -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.3" />
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\MobileContract\MobileContract.csproj" />
    <ProjectReference Include="..\..\libs\BaihuaSdk\BaihuaSdk.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- 禁用裁剪�?AOT，避�?Release 构建�?BlazorWebViewHandler 等类型被误移�?-->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
</Project>



