# 源码构建（多阶段）：build 阶段在离线 SDK 镜像（bh/sdk-offline，含 nuget-local 包源）内现场 publish，
# 宿主/发布机无需安装 .NET SDK，也无需维护 prebuilt 产物；restore 全程离线。
#
# 构建上下文 = 仓库根（services/ + libs/ 源码；nuget-local 已沉底在 sdk-offline 镜像，无需携带）。
#
# 构建命令（nerdctl/docker 通用，context=仓库根）：
#   nerdctl build -f k8s/images/Dockerfile.webui -t bh-webui:latest .

FROM bh/sdk-offline:latest AS build
WORKDIR /src
# 先 COPY 各 csproj 恢复依赖（依赖不变则 restore 层命中缓存）
COPY services/Baihua.Contracts/Baihua.Contracts.csproj services/Baihua.Contracts/
COPY services/Baihua.Web/Baihua.Web.csproj services/Baihua.Web/
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet restore services/Baihua.Web/Baihua.Web.csproj -r linux-x64 --nologo
# 再 COPY 源码（代码变更只影响编译层）
COPY services/ services/
COPY libs/ libs/
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    dotnet publish services/Baihua.Web/Baihua.Web.csproj \
        -c Release -r linux-x64 -o /publish --no-restore --nologo

FROM bh/base-runtime:latest AS runtime
WORKDIR /app

COPY --from=build /publish .

EXPOSE 5177

ENV ASPNETCORE_URLS=http://0.0.0.0:5177
ENV WEBUI_CONFIG_DIR=/app/data
# 后端只有一个：Baihua.Server（K8s Service DNS）。
# 合并前的 FamilyApi__BaseUrl / VaultApi__BaseUrl / AiApi__BaseUrl 三个键已删除。
ENV BaihuaServer__BaseUrl=http://bh-server:8788/

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5177/ || exit 1

ENTRYPOINT ["dotnet", "bh-webui.dll"]
