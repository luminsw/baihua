<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    百花服务器宿主（单一后端进程，默认 8788）：
    只做三件事——配置与日志/遥测管线、按模块装配依赖、映射端点（控制器 + SignalR + MCP + WebSocket）。
    业务代码一律在 Baihua.Modules.* 中；跨模块调用只经 Baihua.Core.Modules 下的接口，不再有进程间 HTTP。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bh-server</AssemblyName>
    <UseAppHost>true</UseAppHost>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">linux-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <GenerateResource>false</GenerateResource>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <RootNamespace>Baihua.Server</RootNamespace>
    <UserSecretsId>baihua-server-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- 集成测试（WebApplicationFactory<Program>）需要访问内部 Program 类 -->
    <InternalsVisibleTo Include="Baihua.Family.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="OpenTelemetry" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.11.2" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Baihua.Data\Baihua.Data.csproj" />
    <ProjectReference Include="..\Baihua.Core\Baihua.Core.csproj" />
    <ProjectReference Include="..\Baihua.Contracts\Baihua.Contracts.csproj" />
    <ProjectReference Include="..\Baihua.AI.Provider\Baihua.AI.Provider.csproj" />
    <ProjectReference Include="..\Baihua.AI.Provider.OpenVino\Baihua.AI.Provider.OpenVino.csproj" />
    <ProjectReference Include="..\Baihua.Modules.Family\Baihua.Modules.Family.csproj" />
    <ProjectReference Include="..\Baihua.Modules.Ai\Baihua.Modules.Ai.csproj" />
    <ProjectReference Include="..\Baihua.Modules.Vault\Baihua.Modules.Vault.csproj" />
    <ProjectReference Include="..\..\libs\MobileContract\MobileContract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="**/*.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenVINO OpenAI 兼容推理服务（OpenClaw 本地 AI 配置启动用 / 算力池跨机部署），随发布拷贝 -->
    <None Include="..\Baihua.AI.Provider.OpenVino\LocalVision\openvino_llm_server.py" Link="LocalVision\openvino_llm_server.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
