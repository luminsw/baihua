@using Baihua.Web.Services
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService AuthService
@inject GlobalStateService GlobalStateService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="nav-menu">
    <FamilyNavMenu />
</div>

@code {
    public void Dispose() { }
}

<style>
    .nav-menu {
        padding: 0;
        max-height: none;
        overflow: visible;
    }

    .nav-group {
        margin-bottom: 1rem;
    }

    .nav-group-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(168, 194, 210, 0.5);
        padding: 0.4rem 0.75rem 0.3rem;
        margin-bottom: 0.2rem;
        user-select: none;
    }

    .nav-group a {
        position: relative;
        display: flex;
        align-items: center;
        color: rgba(214, 231, 240, 0.82);
        text-decoration: none;
        padding: 0.55rem 0.75rem;
        border-radius: 9px;
        margin-bottom: 2px;
        font-size: 0.9rem;
        transition: background-color 0.16s ease, color 0.16s ease;
    }

    .nav-group a:hover {
        background: rgba(255, 255, 255, 0.06);
        color: #fff;
    }

    .nav-group a.active {
        background: rgba(74, 168, 200, 0.22);
        color: #fff;
        font-weight: 600;
        box-shadow: inset 0 0 0 1px rgba(120, 200, 226, 0.22);
    }

    .nav-group a.active::before {
        content: "";
        position: absolute;
        left: 0;
        top: 22%;
        bottom: 22%;
        width: 3px;
        border-radius: 0 3px 3px 0;
        background: #6cc3de;
    }

    .nav-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.2rem;
        height: 1.2rem;
        margin-right: 0.7rem;
        font-size: 0.98rem;
        opacity: 0.78;
    }

    .nav-group a:hover .nav-icon,
    .nav-group a.active .nav-icon {
        opacity: 1;
    }

    .nav-menu::-webkit-scrollbar {
        width: 6px;
    }

    .nav-menu::-webkit-scrollbar-track {
        background: transparent;
    }

    .nav-menu::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.15);
        border-radius: 3px;
    }

    .nav-menu::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.25);
    }
</style>
