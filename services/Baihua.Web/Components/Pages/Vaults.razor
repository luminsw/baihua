@page "/vaults"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits Baihua.Web.Components.PerformanceComponentBase
@using System.IO
@inject VaultsService VaultsService
@inject VaultStatusService VaultStatusService
@inject Baihua.Web.Hubs.StatusUpdateService StatusUpdateService
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IApiService ApiService
@inject ILogger<Vaults> Logger
@inject BackupService BackupService
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<PageTitle>@L["Vaults_PageTitle"]</PageTitle>

<div class="container-fluid mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">📚 @L["Vaults_Title"]</h2>
            <div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshCurrentTab" disabled="@isLoading">🔄 @L["Vaults_Refresh"]</button>
            </div>
        </div>
        <div class="card-body">
            <!-- Tab导航 -->
            <ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "vaults" ? "active" : "")" @onclick='() => SwitchTab("vaults")'>
                        📁 @L["Vaults_TabPathConfig"]
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "git" ? "active" : "")" @onclick='() => SwitchTab("git")'>
                        🌿 @L["Vaults_TabGit"]
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "backup" ? "active" : "")" @onclick='() => SwitchTab("backup")'>
                        💾 @L["Vaults_TabBackup"]
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(activeTab == "trash" ? "active" : "")" @onclick='() => SwitchTab("trash")'>
                        🗑️ @L["Vaults_TabTrash"]
                        @if (trashVaults.Count > 0)
                        {
                            <span class="badge bg-danger ms-1">@trashVaults.Count</span>
                        }
                    </button>
                </li>
            </ul>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-@(success ? "success" : "danger") alert-dismissible fade show">
                    @message
                    @if (success && !string.IsNullOrEmpty(lastCreatedTaskId))
                    {
                        <a href="tasks" class="alert-link ms-2">→ @L["Vaults_ViewTask"]</a>
                    }
                    <button type="button" class="btn-close" @onclick="() => { message = null; lastCreatedTaskId = null; }"></button>
                </div>
            }

            @if (activeTab == "vaults")
            {
                <!-- 知识库路径配置 Tab -->

                <!-- 加载中状态 -->
                @if (isInitializing)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@L["Common_Loading"]</span>
                        </div>
                        <p class="mt-3 text-muted">@L["Vaults_LoadingVaultData"]</p>
                    </div>
                }
                else
                {
                    <!-- 知识库根路径（约定的固定路径） -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">📂 @L["Vaults_RootPath"]</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-2">@L["Vaults_RootPathHint"]</p>
                            <div class="alert alert-info mb-2 py-2">
                                <small>🔒 @L["Vaults_RootPathFixed"]</small>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <input type="text" class="form-control" value="@vaultRootPathPreference" readonly />
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(vaultRootPathPreference))
                            {
                                <small class="text-muted mt-2 d-block">
                                    @if (Directory.Exists(vaultRootPathPreference))
                                    {
                                        <span class="text-success">✅ @L["Vaults_PathExists"]</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">⚠️ @L["Vaults_PathNotExist"]</span>
                                    }
                                </small>
                            }
                        </div>
                    </div>

                <!-- 添加新知识库 -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">➕ @L["Vaults_AddVault"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small mb-1">@L["Vaults_Industry"]</label>
                                <select class="form-select form-select-sm" @bind="newVaultIndustry">
                                    <option value="笔记">📝 @L["Vaults_IndustryNote"]</option>
                                    <option value="计算机">💻 @L["Vaults_IndustryComputer"]</option>
                                    <option value="通用">📘 @L["Vaults_IndustryGeneral"]</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">@L["Vaults_VaultName"]</label>
                                <input type="text" class="form-control form-control-sm" @bind="newVaultName" placeholder="@L["Vaults_VaultNamePlaceholder"]" />
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-sm btn-primary w-100" @onclick="AddNewVault" disabled="@isLoading">
                                    @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    @L["Vaults_Add"]
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(vaultRootPathPreference) && !string.IsNullOrEmpty(newVaultIndustry) && !string.IsNullOrEmpty(newVaultName))
                        {
                            <small class="text-muted d-block mt-2">
                                @L["Vaults_WillCreateAt"]<code>@System.IO.Path.Combine(vaultRootPathPreference, "local", newVaultIndustry, newVaultName)</code>
                            </small>
                        }
                        else if (string.IsNullOrEmpty(vaultRootPathPreference))
                        {
                            <small class="text-warning d-block mt-2">⚠️ @L["Vaults_SetRootPathFirst"]</small>
                        }
                    </div>
                </div>

                <!-- 知识库列表 -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">📋 @L["Vaults_AllVaults"] (@vaults.Count)</h5>
                        <button class="btn btn-sm btn-outline-primary" @onclick="SyncVaults" disabled="@isLoading">
                            @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            🔄 @L["Vaults_SyncVaults"]
                        </button>
                    </div>
                    <div class="card-body p-0">
                        @if (vaults.Count == 0)
                        {
                            <div class="text-center py-4 text-muted">
                                @L["Vaults_NoVaults"]
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["Vaults_TableName"]</th>
                                        <th>@L["Vaults_TablePath"]</th>
                                        <th>@L["Vaults_TableIndustry"]</th>
                                        <th>@L["Vaults_TableCreatedAt"]</th>
                                        <th>@L["Vaults_TableTags"]</th>
                                        <th>@L["Vaults_TableNotes"]</th>
                                        <th>@L["Vaults_TableCards"]</th>
                                        <th>@L["Vaults_TableActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vault in vaults)
                                    {
                                        <tr @key="vault.Id">
                                            <td>
                                                @if (editingVaultId == vault.Id)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control" @bind="editingName" />
                                                        <button class="btn btn-success" @onclick="SaveEdit">✓</button>
                                                        <button class="btn btn-secondary" @onclick="CancelEdit">✕</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <strong>@vault.Name</strong>
                                                }
                                            </td>
                                            <td><code class="small">@vault.Path</code></td>
                                            <td>
                                                @if (editingIndustryVaultId == vault.Id)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <select class="form-select form-select-sm" @bind="editingIndustry">
                                                            <option value="笔记">📝 @L["Vaults_IndustryNote"]</option>
                                                            <option value="计算机">💻 @L["Vaults_IndustryComputer"]</option>
                                                            <option value="通用">📘 @L["Vaults_IndustryGeneral"]</option>
                                                        </select>
                                                        <button class="btn btn-success" @onclick="SaveIndustryEdit">✓</button>
                                                        <button class="btn btn-secondary" @onclick="CancelIndustryEdit">✕</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary" style="cursor: pointer;" @onclick="() => StartIndustryEdit(vault)" title="点击编辑行业">
                                                        @(string.IsNullOrWhiteSpace(vault.Industry) ? "+ " + L["Vaults_SetIndustry"] : vault.Industry)
                                                    </span>
                                                }
                                            </td>
                                            <td>@vault.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                            <td>
                                                @if (editingTagVaultId == vault.Id)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control" @bind="editingTags" placeholder="@L["Vaults_TagsPlaceholder"]" />
                                                        <button class="btn btn-success" @onclick="SaveTagEdit">✓</button>
                                                        <button class="btn btn-secondary" @onclick="CancelTagEdit">✕</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-wrap gap-1 align-items-center" style="min-height: 31px; cursor: pointer;" @onclick="() => StartTagEdit(vault)" title="点击编辑标签">
                                                        @if (vault.Tags?.Any() == true)
                                                        {
                                                            @foreach (var tag in vault.Tags)
                                                            {
                                                                <span class="badge bg-info text-dark" @key="tag">@tag</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">+ @L["Vaults_AddTag"]</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (vaultNoteCounts.GetValueOrDefault(vault.Id, -1) < 0)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-muted"></span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">📝 @vaultNoteCounts[vault.Id] @L["Vaults_NoteCountSuffix"]</span>
                                                }
                                            </td>
                                            <td>
                                                @if (vaultCardCounts.GetValueOrDefault(vault.Id, -1) < 0)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-muted"></span>
                                                }
                                                else if (vaultCardCounts.GetValueOrDefault(vault.Id, 0) == 0)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GenerateCardsForVault(vault)" disabled="@isGeneratingCards">
                                                        @if (isGeneratingCards && generatingVaultId == vault.Id)
                                                        {
                                                            <span class="spinner-border spinner-border-sm"></span>
                                                        }
                                                        else
                                                        {
                                                            <span>🃏 @L["Vaults_GenerateCards"]</span>
                                                        }
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">🃏 @vaultCardCounts[vault.Id] @L["Vaults_CardCountSuffix"]</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-secondary" @onclick="() => StartEdit(vault)" title="重命名">
                                                        @L["Vaults_Rename"]
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(vault)" title="删除">
                                                        @L["Vaults_Delete"]
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
                }
            }
            else if (activeTab == "git")
            {
                @if (isGitLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2">@L["Vaults_Loading"]</p>
                    </div>
                }
                else if (activeVault == null && string.IsNullOrEmpty(vaultRootPathPreference))
                {
                    <div class="alert alert-info">
                        <h5>📋 @L["Vaults_RootPathGit"]</h5>
                        <p class="mb-0">@L["Vaults_GitRootPathHint"]</p>
                    </div>
                }
                else if (gitStatus == null)
                {
                    <div class="alert alert-warning">
                        <h5>⚠️ @L["Vaults_LoadFailed"]</h5>
                        <p class="mb-0">@L["Vaults_GitStatusFail"]</p>
                    </div>
                }
                else if (!gitStatus.IsGitRepo)
                {
                    <div class="alert alert-warning">
                        <h5>⚠️ @gitStatus.Message</h5>
                        <p class="mb-0">@L["Vaults_GitInitHint"]</p>
                    </div>
                }
                else
                {
                    <!-- 状态概览 -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">📊 @L["Vaults_RepoStatus"]</h5>
                                    <table class="table table-sm mb-0">
                                        <tr><td width="100"><strong>@L["Vaults_Branch"]</strong></td><td><code class="bg-white px-2 rounded">@gitStatus.Branch</code></td></tr>
                                        <tr><td><strong>@L["Vaults_Remote"]</strong></td><td>@(gitStatus.HasRemote ? "✅ " + L["Vaults_Configured"] : "❌ " + L["Vaults_NotConfigured"])</td></tr>
                                        <tr><td><strong>@L["Vaults_Changes"]</strong></td><td><span class="badge bg-@(gitStatus.Changes.Count > 0 ? "warning" : "success")">@gitStatus.Changes.Count  @L["Vaults_FileCount"]</span></td></tr>
                                        @if (gitStatus.Ahead > 0 || gitStatus.Behind > 0)
                                        {
                                            <tr><td><strong>@L["Vaults_Sync"]</strong></td><td>
                                                @if (gitStatus.Ahead > 0) { <span class="badge bg-primary me-1">↑ @gitStatus.Ahead  @L["Vaults_PendingPush_Badge"]</span> }
                                                @if (gitStatus.Behind > 0) { <span class="badge bg-secondary">↓ @gitStatus.Behind  @L["Vaults_PendingPull_Badge"]</span> }
                                            </td></tr>
                                        }
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">⚡ @L["Vaults_QuickActions"]</h5>
                                    <button class="btn btn-outline-primary w-100 mb-2" @onclick="DoPull" disabled="@isLoading">
                                        @if (isLoading && action == "pull") { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        ↓ @L["Vaults_PullChanges"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 变更列表 -->
                    @if (gitStatus.Changes.Count > 0)
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-warning bg-opacity-25">
                                <h5 class="mb-0">📝 @L["Vaults_PendingChanges"] (@gitStatus.Changes.Count)</h5>
                            </div>
                            <div class="card-body" style="max-height: 250px; overflow-y: auto;">
                                <ul class="list-group list-group-flush">
                                    @foreach (var change in gitStatus.Changes)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <code>@change.File</code>
                                            <span class="badge @GetStatusBadgeClass(change.Status)">@change.Status</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="card-footer">
                                <div class="row g-2">
                                    <div class="col">
                                        <div class="input-group">
                                            <input type="text" class="form-control" placeholder="@L["Vaults_CommitPlaceholder"]" 
                                                   @bind="commitMessage" @bind:event="oninput" />
                                            <button class="btn btn-success" @onclick="DoCommit" 
                                                    disabled="@(isLoading || string.IsNullOrWhiteSpace(commitMessage))">
                                                @if (isLoading && action == "commit") { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                ✅ @L["Vaults_Commit"]
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-outline-danger" @onclick="ConfirmDiscard" disabled="@isLoading">
                                            @if (isLoading && action == "discard") { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            🗑️ @L["Vaults_DiscardChanges"]
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mb-4">
                            ✅ @gitStatus.Message
                        </div>
                    }

                    <!-- 推送按钮 -->
                    @if (gitStatus.Ahead > 0)
                    {
                        <div class="card mb-4 border-primary">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">🚀 @L["Vaults_PendingPush"] (@gitStatus.Ahead)</h5>
                            </div>
                            <div class="card-body">
                                @if (unpushedCommits.Count > 0)
                                {
                                    <table class="table table-sm mb-3">
                                        <tbody>
                                            @foreach (var c in unpushedCommits)
                                            {
                                                <tr>
                                                    <td style="width: 70px;"><code class="small">@c.Hash.Substring(0, Math.Min(7, c.Hash.Length))</code></td>
                                                    <td>
                                                        <strong>@c.Message</strong>
                                                        <br />
                                                        <small class="text-muted">@c.Author · @c.Date</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                <div class="d-flex justify-content-end">
                                    <button class="btn btn-primary btn-lg" @onclick="DoPush" disabled="@isLoading">
                                        @if (isLoading && action == "push") { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        ↑ @L["Vaults_PushToRemote"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- 提交历史 -->
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">📜 @L["Vaults_RecentCommits"]</h5>
                        </div>
                        <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            @if (commits.Count > 0)
                            {
                                <table class="table table-hover mb-0">
                                    <tbody>
                                        @foreach (var c in commits)
                                        {
                                            <tr>
                                                <td style="width: 80px;"><code class="small">@c.Hash.Substring(0, Math.Min(7, c.Hash.Length))</code></td>
                                                <td>
                                                    <strong>@c.Message</strong>
                                                    <br />
                                                    <small class="text-muted">@c.Author · @c.Date</small>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted text-center py-3 mb-0">@L["Vaults_NoCommits"]</p>
                            }
                        </div>
                    </div>
                }
            }
            else if (activeTab == "backup")
            {
                <!-- 备份恢复 Tab -->
                <div class="row">
                    <!-- 创建备份 -->
                    <div class="col-md-6">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">💾 @L["Vaults_CreateBackup"]</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted small">@L["Vaults_BackupDescription"]</p>

                                <div class="mb-3">
                                    <label class="form-label">@L["Vaults_BackupDir"]</label>
                                    <input type="text" class="form-control form-control-sm" @bind="backupDir" placeholder="@L["Vaults_BackupDirPlaceholder"]" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">@L["Vaults_BackupPassword"]</label>
                                    <input type="password" class="form-control form-control-sm" @bind="backupPassword" placeholder="@L["Vaults_BackupPasswordPlaceholder"]" />
                                    <small class="text-muted">@L["Vaults_BackupPasswordHint"]</small>
                                </div>

                                <button class="btn btn-primary btn-sm" @onclick="CreateBackup" disabled="@isBackupLoading">
                                    @if (isBackupLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    @L["Vaults_CreateFullBackup"]
                                </button>

                                @if (!string.IsNullOrEmpty(backupResultMessage))
                                {
                                    <div class="alert alert-@(backupResultSuccess ? "success" : "danger") mt-3 mb-0 small">
                                        @backupResultMessage
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- L["Vaults_DoRestore"] -->
                    <div class="col-md-6">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">📂 @L["Vaults_RestoreBackup"]</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label">@L["Vaults_BackupFilePath"]</label>
                                    <input type="text" class="form-control form-control-sm" @bind="restoreBackupPath" placeholder="@L["Vaults_BackupFilePlaceholder"]" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">@L["Vaults_RestorePassword"]</label>
                                    <input type="password" class="form-control form-control-sm" @bind="restorePassword" placeholder="@L["Vaults_RestorePasswordPlaceholder"]" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">@L["Vaults_RootPathOverride"]</label>
                                    <input type="text" class="form-control form-control-sm" @bind="restoreVaultRootOverride" placeholder="@L["Vaults_RootPathOverridePlaceholder"]" />
                                    <small class="text-muted">@L["Vaults_RootPathOverrideHint"]</small>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" @bind="restoreOverwrite" id="restoreOverwrite" />
                                    <label class="form-check-label" for="restoreOverwrite">@L["Vaults_OverwriteData"]</label>
                                </div>

                                @if (restoreValidation != null)
                                {
                                    <div class="alert alert-info small mb-3">
                                        <strong>@L["Vaults_BackupInfo"]</strong><br />
                                        @L["Vaults_Version"]@restoreValidation.Version<br />
                                        @L["Vaults_CreatedAtLabel"]@(restoreValidation.CreatedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? @L["Vaults_Unknown"])<br />
                                        @L["Vaults_SourcePlatform"]@restoreValidation.SourceOS<br />
                                        @if (restoreValidation.HasPassword)
                                        {
                                            <span class="text-warning">🔒 @L["Vaults_PasswordProtected"]</span><br />
                                        }
                                        @L["Vaults_VaultCount"]@restoreValidation.VaultCount
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="ValidateBackup" disabled="@isRestoreLoading || string.IsNullOrEmpty(restoreBackupPath)">
                                        @L["Vaults_ValidateBackup"]
                                    </button>
                                    <button class="btn btn-warning btn-sm" @onclick="RestoreBackup" disabled="@isRestoreLoading || string.IsNullOrEmpty(restoreBackupPath)">
                                        @if (isRestoreLoading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        @L["Vaults_DoRestore"]
                                    </button>
                                </div>

                                @if (!string.IsNullOrEmpty(restoreResultMessage))
                                {
                                    <div class="alert alert-@(restoreResultSuccess ? "success" : "danger") mt-3 mb-0 small">
                                        @restoreResultMessage
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 备份列表 -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">📋 @L["Vaults_ExistingBackups"]</h5>
                    </div>
                    <div class="card-body">
                        @if (backupList.Count == 0)
                        {
                            <p class="text-muted text-center py-3 mb-0">@L["Vaults_NoBackups"]</p>
                        }
                        else
                        {
                            <table class="table table-sm table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["Vaults_TableFileName"]</th>
                                        <th>@L["Vaults_TableSize"]</th>
                                        <th>@L["Vaults_TableCreatedAt"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in backupList)
                                    {
                                        <tr>
                                            <td><code>@b.FileName</code></td>
                                            <td>@FormatFileSize(b.Size)</td>
                                            <td>@b.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "trash")
            {
                <!-- 回收站 Tab -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">🗑️ @L["Vaults_TabTrash"] (@trashVaults.Count)</h5>
                    @if (trashVaults.Count > 0)
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="ConfirmEmptyTrash" disabled="@isLoading">
                            🧹 @L["Vaults_EmptyTrash"]
                        </button>
                    }
                </div>

                @if (trashVaults.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">@L["Vaults_TrashEmpty"]</p>
                        <small>@L["Vaults_TrashHint"]</small>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>@L["Vaults_TableName"]</th>
                                        <th>@L["Vaults_TablePath"]</th>
                                        <th>@L["Vaults_TableIndustry"]</th>
                                        <th>@L["Vaults_TableActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vault in trashVaults)
                                    {
                                        <tr @key="vault.Id">
                                            <td><strong>@vault.Name</strong></td>
                                            <td><code class="small">@vault.Path</code></td>
                                            <td>@(string.IsNullOrWhiteSpace(vault.Industry) ? "-" : vault.Industry)</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => ConfirmRestore(vault)">
                                                    ↩️ @L["Vaults_Restore"]
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

