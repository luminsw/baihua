                VaultStatusService.NotifyStateChanged();
            }
            else
            {
                message = $"删除失败: {error}";
                this.success = false;
            }
        }
        catch (Exception ex)
        {
            message = $"删除失败: {ex.Message}";
            success = false;
        }
        finally
        {
            isLoading = false;
            vaultToDelete = null;
        }
    }

