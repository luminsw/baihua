@page "/ai-metrics"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.Metrics
@inject Baihua.Web.Services.IApiService ApiService
@implements IDisposable
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<PageTitle>@L["AiMetrics_PageTitle"]</PageTitle>

<h1>@L["AiMetrics_Title"]</h1>

@if (isLoading)
{
    <div class="loading-spinner">@L["AiMetrics_Loading"]</div>
}
else
{
    <!-- 时间范围选择 -->
    <div class="metrics-filter">
        <span>@L["AiMetrics_TimeRangeLabel"]</span>
        @foreach (var d in dayOptions)
        {
            <button class="btn btn-sm @(selectedDays == d ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => ChangeDays(d)">
                @L["AiMetrics_DaysFormat", d]
            </button>
        }
    </div>

    <!-- 总览卡片 -->
    <div class="metrics-cards">
        <div class="metric-card">
            <div class="metric-value">@summary?.TotalCalls</div>
            <div class="metric-label">@L["AiMetrics_TotalCalls"]</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@(summary?.AvgLatencyMs)ms</div>
            <div class="metric-label">@L["AiMetrics_AvgLatency"]</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@(summary?.SuccessRate)%</div>
            <div class="metric-label">@L["AiMetrics_SuccessRate"]</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@FormatNumber(summary?.TotalTokens ?? 0)</div>
            <div class="metric-label">@L["AiMetrics_TotalTokens"]</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">@(summary?.BestProvider ?? "-")</div>
            <div class="metric-label">@L["AiMetrics_BestProvider"] @(summary?.BestProviderTps != null ? $"({Math.Round(summary.BestProviderTps.Value, 1)} tps)" : "")
            </div>
        </div>
    </div>

    <!-- 趋势图 -->
    @if (trends?.Count > 0)
    {
        <div class="metrics-section">
            <h3>@L["AiMetrics_TrendTitle", selectedDays]</h3>
            <div class="trend-chart">
                @foreach (var t in trends)
                {
                    var height = maxTrendCalls > 0 ? (int)(t.CallCount * 100.0 / maxTrendCalls) : 0;
                    <div class="trend-bar-wrapper" title="@t.Date：@t.CallCount 次调用，平均 @t.AvgLatencyMs ms">
                        <div class="trend-bar-track">
                            <div class="trend-bar" style="height: @(height)%"></div>
                        </div>
                        <div class="trend-label">@t.Date.Substring(5)</div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Provider 排行榜 -->
    <div class="metrics-section">
        <h3>@L["AiMetrics_ProviderRankingTitle"]</h3>
        @if (providerMetrics?.Count > 0)
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Provider</th>
                        <th>@L["AiMetrics_Col_CallCount"]</th>
                        <th>@L["AiMetrics_Col_AvgLatency"]</th>
                        <th>@L["AiMetrics_Col_AvgTps"]</th>
                        <th>@L["AiMetrics_Col_SuccessRate"]</th>
                        <th>@L["AiMetrics_Col_TotalTokens"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in providerMetrics)
                    {
                        <tr>
                            <td>@p.ProviderName</td>
                            <td>@p.CallCount</td>
                            <td>@p.AvgLatencyMs ms</td>
                            <td>@(p.AvgTokensPerSecond?.ToString("F1") ?? "-")</td>
                            <td>@p.SuccessRate%</td>
                            <td>@FormatNumber(p.TotalTokens)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">@L["AiMetrics_NoData"]</p>
        }
    </div>

    <!-- 模型排行榜 -->
    <div class="metrics-section">
        <h3>@L["AiMetrics_ModelRankingTitle"]</h3>
        @if (modelMetrics?.Count > 0)
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@L["AiMetrics_Col_Model"]</th>
                        <th>Provider</th>
                        <th>@L["AiMetrics_Col_CallCount"]</th>
                        <th>@L["AiMetrics_Col_AvgLatency"]</th>
                        <th>@L["AiMetrics_Col_AvgTps"]</th>
                        <th>@L["AiMetrics_Col_SuccessRate"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in modelMetrics)
                    {
                        <tr>
                            <td>@m.ModelId</td>
                            <td>@m.ProviderName</td>
                            <td>@m.CallCount</td>
                            <td>@m.AvgLatencyMs ms</td>
                            <td>@(m.AvgTokensPerSecond?.ToString("F1") ?? "-")</td>
                            <td>@m.SuccessRate%</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">@L["AiMetrics_NoData"]</p>
        }
    </div>

    <!-- 最近调用记录 -->
    <div class="metrics-section">
        <h3>@L["AiMetrics_RecentCallsTitle"]</h3>
        @if (recentMetrics?.Count > 0)
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>@L["AiMetrics_Col_Time"]</th>
                        <th>Provider</th>
                        <th>@L["AiMetrics_Col_Model"]</th>
                        <th>@L["AiMetrics_Col_Operation"]</th>
                        <th>@L["AiMetrics_Col_Latency"]</th>
                        <th>Tokens</th>
                        <th>TPS</th>
                        <th>@L["AiMetrics_Col_Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in recentMetrics)
                    {
                        <tr class="@(r.IsSuccess ? "" : "table-danger")">
                            <td>@r.CalledAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                            <td>@r.ProviderName</td>
                            <td>@r.ModelId</td>
                            <td>@r.Operation</td>
                            <td>@r.LatencyMs ms</td>
                            <td>@(r.TotalTokens?.ToString() ?? "-")</td>
                            <td>@(r.TokensPerSecond?.ToString("F1") ?? "-")</td>
                            <td>@(r.IsSuccess ? "✅" : "❌")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">@L["AiMetrics_NoData"]</p>
        }
    </div>
}

<style>
    .metrics-filter {
        margin-bottom: 1rem;
    }
    .metrics-filter button {
        margin-right: 0.5rem;
    }
    .metrics-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .metric-card {
        background: var(--bs-light);
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
    }
    .metric-value {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--bs-primary);
    }
    .metric-label {
        font-size: 0.85rem;
        color: var(--bs-secondary);
        margin-top: 0.25rem;
    }
    .metrics-section {
        margin-bottom: 2rem;
    }
    .metrics-section h3 {
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
    }
    .trend-chart {
        display: flex;
        align-items: flex-end;
        height: 150px;
        gap: 8px;
        padding: 0.5rem;
        background: var(--bs-light);
        border-radius: 8px;
    }
    .trend-bar-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }
    .trend-bar {
        width: 100%;
        background: var(--bs-primary);
        border-radius: 4px 4px 0 0;
        min-height: 4px;
        transition: height 0.3s ease;
    }
    .trend-label {
        font-size: 0.7rem;
        color: var(--bs-secondary);
        margin-top: 4px;
        white-space: nowrap;
    }
</style>

@code {
    private bool isLoading = true;
    private int selectedDays = 7;
    private readonly int[] dayOptions = new[] { 1, 7, 30 };

    private AiMetricsSummaryDto? summary;
    private List<AiProviderMetricsDto> providerMetrics = new();
    private List<AiModelMetricsDto> modelMetrics = new();
    private List<AiMetricsTrendDto> trends = new();
    private List<AiUsageMetricDto> recentMetrics = new();

    private int maxTrendCalls => trends.Count > 0 ? trends.Max(t => t.CallCount) : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        StateHasChanged();

        summary = await ApiService.GetAiMetricsSummaryAsync(selectedDays);
        providerMetrics = await ApiService.GetAiProviderMetricsAsync(selectedDays);
        modelMetrics = await ApiService.GetAiModelMetricsAsync(selectedDays);
        trends = await ApiService.GetAiMetricsTrendsAsync(selectedDays);
        recentMetrics = await ApiService.GetAiRecentMetricsAsync(50, selectedDays);

        isLoading = false;
        StateHasChanged();
    }

    private async Task ChangeDays(int days)
    {
        selectedDays = days;
        await LoadDataAsync();
    }

    private static string FormatNumber(long n)
    {
        if (n >= 1_000_000) return $"{n / 1_000_000.0:F1}M";
        if (n >= 1_000) return $"{n / 1_000.0:F1}K";
        return n.ToString();
    }

    public void Dispose() { }
}

<style>
    /* ---------- AI 性能监控视觉细化 ---------- */
    .metrics-filter { display: flex; align-items: center; gap: 4px; padding: 4px; background: var(--bh-surface-3); border-radius: 11px; width: fit-content; }
    .metrics-filter button { margin: 0; border: none; background: transparent; border-radius: 8px; padding: 0.32rem 0.85rem; font-size: 0.85rem; color: var(--bh-ink-500); }
    .metrics-filter button.active { background: var(--bh-surface); color: var(--bh-brand-700); font-weight: 600; box-shadow: var(--bh-shadow-xs); }

    .metrics-cards { gap: 0.7rem; }
    .metric-card {
        padding: 0.85rem 1rem;
        text-align: left;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
    }
    .metric-value {
        font-size: 1.45rem;
        font-weight: 700;
        line-height: 1.25;
        color: var(--bh-ink-900);
        font-variant-numeric: tabular-nums;
    }
    .metric-label { font-size: 0.78rem; color: var(--bh-ink-500); margin-top: 0.15rem; }

    .metrics-section h3 { font-size: 0.95rem; font-weight: 650; color: var(--bh-ink-700); }

    /* 趋势柱状图：固定轨道高度，避免柱体撑满 */
    .trend-chart {
        height: 168px;
        align-items: stretch;
        gap: 10px;
        padding: 0.75rem 0.9rem 0.55rem;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
    }

    .trend-bar-wrapper {
        position: relative;
        justify-content: flex-end;
        padding-bottom: 20px;
        min-width: 0;
    }

    .trend-bar {
        width: 100%;
        max-width: 42px;
        margin: 0 auto;
        background: linear-gradient(180deg, var(--bh-brand-500), var(--bh-brand-600));
        border-radius: 5px 5px 0 0;
        min-height: 3px;
    }

    .trend-bar:hover { filter: brightness(1.08); }

    .trend-label {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.68rem;
        color: var(--bh-ink-400);
        line-height: 1.4;
    }

    /* 表格 */
    .metrics-section .table { font-size: 0.85rem; }
    .metrics-section .table > thead th {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--bh-ink-400);
        border-bottom: 1px solid var(--bh-border);
        background: var(--bh-surface-2);
        white-space: nowrap;
    }
    .metrics-section .table > tbody > tr:hover { background: var(--bh-surface-2); }
    .metrics-section .table td { color: var(--bh-ink-700); vertical-align: middle; }
</style>
<style>
    /* ---------- 趋势图最终版：基线 + 网格 + 圆角柱 ---------- */
    .trend-chart {
        position: relative;
        height: 190px;
        display: flex;
        align-items: stretch;
        gap: 10px;
        padding: 1rem 1rem 1.7rem;
        background:
            repeating-linear-gradient(to top,
                transparent 0, transparent calc(25% - 1px),
                var(--bh-border) calc(25% - 1px), var(--bh-border) 25%) 0 1rem/100% calc(100% - 2.7rem) no-repeat,
            var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
        overflow: hidden;
    }

    .trend-chart::after {
        content: "";
        position: absolute;
        left: 1rem;
        right: 1rem;
        bottom: 1.62rem;
        border-top: 1px solid var(--bh-border-strong);
    }

    .trend-bar-wrapper {
        position: relative;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .trend-bar-track {
        flex: 1;
        width: 100%;
        min-height: 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .trend-bar {
        width: 100%;
        max-width: 34px;
        min-height: 2px;
        border-radius: 6px 6px 0 0;
        background: linear-gradient(180deg, var(--bh-brand-500), var(--bh-brand-600));
        transition: filter .15s ease;
    }

    .trend-bar[style*="height: 0%"] {
        min-height: 2px;
        background: var(--bh-border-strong);
        border-radius: 2px;
    }

    .trend-bar-wrapper:hover .trend-bar { filter: brightness(1.1); }

    .trend-label {
        margin-top: 0.4rem;
        font-size: 0.68rem;
        color: var(--bh-ink-400);
        line-height: 1.2;
        white-space: nowrap;
    }

    .trend-bar-wrapper:hover .trend-label { color: var(--bh-brand-700); }
</style>
