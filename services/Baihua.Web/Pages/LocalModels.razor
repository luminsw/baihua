@page "/local-models"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Baihua.Contracts.LocalModels
@inject Baihua.Web.Services.IApiService ApiService
@inject Microsoft.Extensions.Localization.IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject Microsoft.Extensions.Logging.ILogger<LocalModels> Logger

<PageTitle>@L["LocalModels_PageTitle"]</PageTitle>

<h1>🖥️ @L["LocalModels_Title"]</h1>

@if (isLoading)
{
    <div class="loading-spinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["LocalModels_Loading"]</span>
        </div>
        <div class="mt-2">@L["LocalModels_Refreshing"]</div>
    </div>
}
else
{
    <div class="d-flex justify-content-end mb-2">
        <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh" disabled="@isRefreshing">
            @(isRefreshing ? "🔄 " + L["LocalModels_Refreshing"] : "🔄 " + L["LocalModels_RefreshModels"])
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="load-message @(success ? "text-success" : "text-error") mb-2">@message</div>
    }

    @if (downloadedModels.Count == 0)
    {
        <div class="alert alert-info">@L["LocalModels_NoDownloadedModels"]</div>
    }
    else
    {
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>@L["LocalModels_Col_Model"]</th>
                    <th>@L["LocalModels_Col_Params"]</th>
                    <th>@L["LocalModels_Col_Size"]</th>
                    <th>@L["LocalModels_Col_Usage"]</th>
                    <th>@L["LocalModels_Col_Tool"]</th>
                    <th>@L["LocalModels_Col_Status"]</th>
                    <th class="text-end">@L["LocalModels_Col_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in downloadedModels)
                {
                    <tr>
                        <td>
                            <div class="model-name-text">@m.Name</div>
                            @if (!string.IsNullOrEmpty(m.Digest))
                            {
                                <div class="digest-text" title="@m.Digest">@m.Digest[..Math.Min(12, m.Digest.Length)]...</div>
                            }
                        </td>
                        <td class="small text-muted">@(string.IsNullOrEmpty(m.Quantization) ? m.ParameterSize : $"{m.ParameterSize} {m.Quantization}")</td>
                        <td class="small text-muted">@m.SizeGiB.ToString("F1") GB</td>
                        <td class="small text-muted">@m.Usage</td>
                        <td><span class="tool-badge @GetToolBadgeClass(m.ToolId)">@GetToolLabel(m)</span></td>
                        <td>
                            @if (m.IsRunning)
                            {
                                <span class="badge badge-success">@L["LocalModels_Running"]</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">@L["LocalModels_DownloadedBadge"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => AskDelete(m)'>@L["LocalModels_DeleteBtn"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (modelToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content modal-small" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>⚠️ @L["LocalModels_DeleteConfirmTitle"]</h3>
                <button class="modal-close" @onclick="CancelDelete">×</button>
            </div>
            <div class="modal-body">
                <p>@L["LocalModels_DeleteConfirmText", modelToDelete.Name]</p>
                <p>@L["LocalModels_DeleteSize", modelToDelete.SizeGiB.ToString("F1")]</p>
                <p class="text-error">@L["LocalModels_DeleteIrreversible"]</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelDelete">@L["Common_Cancel"]</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                    @(isDeleting ? L["LocalModels_Deleting"] : L["LocalModels_DeleteConfirmBtn"])
                </button>
            </div>
        </div>
    </div>
}

<style>
    .loading-spinner {
        padding: 2rem;
        text-align: center;
        color: #666;
    }

    .model-name-text {
        font-weight: 500;
    }

    .digest-text {
        font-size: 0.75rem;
        color: #888;
    }

    .tool-badge {
        display: inline-block;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .tool-openvino {
        background: #e8f0e8;
        color: #3d7a4d;
    }

    .tool-generic {
        background: #e8eef2;
        color: #4a5860;
    }

    .load-message {
        font-size: 0.9rem;
    }

    .text-success {
        color: #6b9e75;
    }

    .text-error {
        color: #c94c4c;
    }

    .badge-success {
        background: #6b9e75;
        color: white;
    }

    .badge-secondary {
        background: #5a6a72;
        color: white;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal-content {
        background: white;
        border-radius: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        max-width: 90vw;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .modal-small {
        width: 420px;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #e8eef2;
    }

    .modal-header h3 {
        margin: 0;
        font-size: 1.1rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #888;
        line-height: 1;
    }

    .modal-close:hover {
        color: #333;
    }

    .modal-body {
        padding: 1.25rem;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 1rem 1.25rem;
        border-top: 1px solid #e8eef2;
    }

    [data-bs-theme="dark"] {
        .loading-spinner { color: #91a0b0; }
        .digest-text { color: #8090a0; }
        .tool-openvino { background: rgba(61, 122, 77, 0.22); color: #8fc79e; }
        .tool-generic { background: #2d3548; color: #c0c8d0; }
        .modal-content { background: #232a3b; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6); }
        .modal-header { border-bottom-color: #2d3548; }
        .modal-footer { border-top-color: #2d3548; }
        .modal-close { color: #91a0b0; }
        .modal-close:hover { color: #d4d8dd; }
    }
</style>

@code {
    private bool isLoading = true;
    private bool isRefreshing = false;
    private bool isDeleting = false;
    private string message = "";
    private bool success = true;
    private List<DownloadedModelDto> downloadedModels = new();
    private DownloadedModelDto? modelToDelete;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载本地模型列表失败");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        downloadedModels = await ApiService.GetDownloadedModelsAsync();
    }

    private async Task Refresh()
    {
        isRefreshing = true;
        message = "";
        try
        {
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "刷新本地模型列表失败");
            message = ex.Message;
            success = false;
        }
        finally
        {
            isRefreshing = false;
            StateHasChanged();
        }
    }

    private void AskDelete(DownloadedModelDto model)
    {
        modelToDelete = model;
        message = "";
    }

    private void CancelDelete()
    {
        modelToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (modelToDelete == null) return;
        var target = modelToDelete;
        isDeleting = true;
        try
        {
            var ok = await ApiService.DeleteModelAsync(new DeleteModelRequest
            {
                ToolId = target.ToolId,
                ModelName = target.Name
            });

            if (ok)
            {
                message = string.Format(L["LocalModels_DeletedOk"], target.Name);
                success = true;
                modelToDelete = null;
                await LoadAsync();
            }
            else
            {
                message = L["LocalModels_DeleteFailedToolDown"];
                success = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "删除模型失败");
            message = string.Format(L["LocalModels_DeleteException"], ex.Message);
            success = false;
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }

    private static string GetToolLabel(DownloadedModelDto m)
    {
        return m.ToolId?.ToLowerInvariant() switch
        {
            "openvino" => "Intel OpenVINO",
            _ => string.IsNullOrWhiteSpace(m.ToolName) ? (m.ToolId ?? "") : m.ToolName,
        };
    }

    private static string GetToolBadgeClass(string? toolId)
    {
        return toolId?.ToLowerInvariant() switch
        {
            "openvino" => "tool-openvino",
            _ => "tool-generic",
        };
    }
}