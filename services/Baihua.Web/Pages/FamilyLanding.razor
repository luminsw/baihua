@page "/family"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.VaultsService VaultsService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<FamilyLanding> Logger
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L

<PageTitle>@L["FamilyLanding_PageTitle"]</PageTitle>

<div class="family-landing">
    <div class="bh-page-header">
        <div>
            <h1 class="bh-page-title"><span class="bh-page-emoji">👨‍👩‍👧</span>@L["FamilyLanding_Title"]</h1>
            <p class="bh-page-sub">@L["FamilyLanding_Subtitle"]</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">@L["FamilyLanding_Loading"]</div>
    }
    else if (showOnboarding)
    {
        <!-- FAM-34 Onboarding 向导（无 Learner + 未完成标记） -->
        <div class="onboarding-wizard">
            <div class="onboarding-header">
                <button class="onboarding-skip" @onclick="SkipOnboarding">@L["FamilyLanding_Skip"] ✕</button>
            </div>

            @if (onboardingStep == 1)
            {
                <div class="onboarding-card" data-step="Step 1">
                    <h2>👋 @L["FamilyLanding_WelcomeTitle"]</h2>
                    <p>@L["FamilyLanding_WelcomeSubtitle"]</p>
                    <div class="onboarding-form">
                        <input type="text" class="form-control" @bind="newLearnerName" placeholder="@L["FamilyLanding_LearnerNamePlaceholder"]" />
                        @if (!string.IsNullOrEmpty(onboardingError))
                        {
                            <p class="onboarding-error">@onboardingError</p>
                        }
                        <button class="btn btn-primary" @onclick="CreateLearnerFromOnboarding" disabled="@isOnboardingBusy">@L["FamilyLanding_Start"]</button>
                    </div>
                </div>
            }
            else if (onboardingStep == 2)
            {
                <div class="onboarding-card" data-step="Step 2">
                    <h2>📖 @L["FamilyLanding_FirstStudyTitle"]</h2>
                    <p>@L["FamilyLanding_FirstStudySubtitle"]</p>
                    <a class="guide-button" href="daily-card">@L["FamilyLanding_GoDailyCard"] ➡️</a>
                </div>
            }
            else if (onboardingStep == 3)
            {
                <div class="onboarding-card" data-step="Step 3">
                    <h2>🎉 @L["FamilyLanding_CongratsTitle"]</h2>
                    <p>@L["FamilyLanding_CongratsSubtitle"]</p>
                    <a class="guide-button" href="/checkin">@L["FamilyLanding_ViewCheckin"] ➡️</a>
                </div>
            }

            <div class="onboarding-steps">
                <span class="ob-step @(onboardingStep >= 1 ? "active" : "")">@L["FamilyLanding_Step1"]</span>
                <span class="ob-step @(onboardingStep >= 2 ? "active" : "")">@L["FamilyLanding_Step2"]</span>
                <span class="ob-step @(onboardingStep >= 3 ? "active" : "")">@L["FamilyLanding_Step3"]</span>
                <span class="ob-step @(onboardingStep >= 4 ? "active" : "")">Done</span>
            </div>
        </div>
    }
    else if (learners.Count == 0)
    {
        <!-- 无 Learner 引导（不空白） -->
        <div class="empty-guide">
            <div class="guide-icon">🌱</div>
            <h2>@L["FamilyLanding_NoLearnerGuideTitle"]</h2>
            <p>@L["FamilyLanding_NoLearnerGuideDesc"]</p>
            <a class="guide-button" href="achievements">@L["FamilyLanding_GoCreateLearner"] ➡️</a>
        </div>
    }
    else
    {
        <!-- 区域 1：家庭学习汇总卡片 -->
        <div class="family-summary">
            <div class="summary-card">
                <div class="summary-icon">📚</div>
                <div class="summary-text">
                    <div class="summary-value">@todayTotal</div>
                    <div class="summary-label">@L["FamilyLanding_TodayLearned"]</div>
                </div>
            </div>
            <div class="summary-card">
                <div class="summary-icon">🔥</div>
                <div class="summary-text">
                    <div class="summary-value">@maxStreak<span class="summary-unit">天</span></div>
                    <div class="summary-label">@L["FamilyLanding_MaxStreak"]</div>
                </div>
            </div>
        </div>

        <!-- 区域 2：成员学习快照 -->
        <div class="section">
            <div class="section-header">
                <h2>@L["FamilyLanding_MemberSnapshot"]</h2>
            </div>
            <div class="member-snapshot">
                @foreach (var member in data.FamilyStats)
                {
                    <div class="member-card">
                        <div class="member-header">
                            <span class="member-avatar" style="background:@member.Color">@member.AvatarEmoji</span>
                            <span class="member-name">@member.Name</span>
                        </div>
                        <div class="member-stats">
                            <div class="m-stat">
                                <div class="m-value">@member.WeekTotal</div>
                                <div class="m-label">@L["FamilyLanding_WeekTotal"]</div>
                            </div>
                            <div class="m-stat">
                                <div class="m-value">@member.Streak</div>
                                <div class="m-label">🔥 @L["FamilyLanding_Streak"]</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 区域 3：每日卡片捷径 -->
        <div class="section">
            <div class="section-header">
                <h2>@L["FamilyLanding_DailyCardShortcut"]</h2>
            </div>
            <a class="daily-card-shortcut" href="daily-card">
                <span class="shortcut-icon">🃏</span>
                <span class="shortcut-text">
                    <span class="shortcut-title">@L["FamilyLanding_DailyCardTitle"]</span>
                    <span class="shortcut-desc">@L["FamilyLanding_DailyCardDesc"]</span>
                </span>
                <span class="shortcut-arrow" aria-hidden="true">›</span>
            </a>
        </div>

        <!-- 区域 3b：题库学习（多行业） -->
        <div class="section">
            <div class="section-header">
                <h2>题库学习</h2>
            </div>
            <a class="daily-card-shortcut" href="/learn">
                <span class="shortcut-icon">📚</span>
                <span class="shortcut-text">
                    <span class="shortcut-title">刷题闯关 · 多行业题库</span>
                    <span class="shortcut-desc">按行业选择题库，看题选答案，即时解析与易混淆项区分点</span>
                </span>
                <span class="shortcut-arrow" aria-hidden="true">›</span>
            </a>
        </div>

        <!-- 区域 4：本周排行预览 -->
        <div class="section">
            <div class="section-header">
                <h2>@L["FamilyLanding_LeaderboardPreview"]</h2>
                <a href="leaderboard" class="section-link">@L["FamilyLanding_ViewMore"]</a>
            </div>
            <div class="leaderboard-preview">
                @if (leaderboardEntries.Count > 0)
                {
                    @foreach (var entry in leaderboardEntries.Take(5))
                    {
                        <div class="leaderboard-row">
                            <span class="lb-avatar" style="background:@entry.Color">@entry.AvatarEmoji</span>
                            <span class="lb-name">@entry.LearnerName</span>
                            <span class="lb-score">@entry.Score @L["FamilyLanding_Points"]</span>
                        </div>
                    }
                }
                else
                {
                    <div class="section-empty">@L["FamilyLanding_NoLeaderboardData"]</div>
                }
            </div>
        </div>
    }
</div>


<style>
    .family-landing {
        max-width: 980px;
        margin: 0 auto;
        padding: 1.25rem 1rem 3rem;
    }

    .loading {
        text-align: center;
        padding: 3rem;
        color: var(--bh-ink-400);
    }

    /* ---------- 空态引导 ---------- */
    .empty-guide {
        text-align: center;
        padding: 3rem 1.5rem;
        background: var(--bh-surface-2);
        border: 1.5px dashed var(--bh-border-strong);
        border-radius: var(--bh-radius-lg);
    }

    .guide-icon { font-size: 2.6rem; margin-bottom: 0.6rem; line-height: 1; }

    .empty-guide h2 {
        font-size: 1.15rem;
        font-weight: 650;
        color: var(--bh-ink-900);
        margin-bottom: 0.4rem;
    }

    .empty-guide p {
        color: var(--bh-ink-500);
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
    }

    .guide-button {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.5rem 1.15rem;
        background: var(--bh-brand-600);
        color: #fff;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: var(--bh-shadow-xs);
        transition: background 0.15s ease, transform 0.15s ease;
    }

    .guide-button:hover { background: var(--bh-brand-700); color: #fff; transform: translateY(-1px); }

    /* ---------- 汇总数字 ---------- */
    .family-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.85rem;
        margin-bottom: 1.75rem;
    }

    .summary-card {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem 1.15rem;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
    }

    .summary-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        font-size: 1.35rem;
        background: var(--bh-brand-50);
        border: 1px solid var(--bh-brand-100);
        border-radius: 12px;
    }

    .summary-text { min-width: 0; }

    .summary-value {
        font-size: 1.55rem;
        font-weight: 700;
        line-height: 1.15;
        color: var(--bh-ink-900);
        font-variant-numeric: tabular-nums;
    }

    .summary-unit {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--bh-ink-400);
        margin-left: 0.15rem;
    }

    .summary-label {
        margin-top: 0.15rem;
        font-size: 0.82rem;
        color: var(--bh-ink-500);
    }

    /* ---------- 区块 ---------- */
    .section { margin-bottom: 1.75rem; }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.7rem;
    }

    .section-header h2 {
        margin: 0;
        font-size: 1rem;
        font-weight: 650;
        letter-spacing: 0.01em;
        color: var(--bh-ink-700);
    }

    .section-link {
        color: var(--bh-brand-600);
        text-decoration: none;
        font-size: 0.83rem;
        font-weight: 500;
    }

    .section-link:hover { color: var(--bh-brand-700); text-decoration: underline; }

    /* ---------- 成员快照 ---------- */
    .member-snapshot {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 0.75rem;
    }

    .member-card {
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius);
        padding: 0.95rem 1rem;
        box-shadow: var(--bh-shadow-xs);
        transition: box-shadow 0.15s ease, border-color 0.15s ease;
    }

    .member-card:hover { border-color: var(--bh-border-strong); box-shadow: var(--bh-shadow-sm); }

    .member-header {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 0.85rem;
    }

    .member-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 50%;
        font-size: 1.05rem;
        color: #fff;
        box-shadow: 0 1px 3px rgba(16, 34, 45, 0.16);
    }

    .member-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--bh-ink-900);
    }

    .member-stats {
        display: flex;
        gap: 0.5rem;
    }

    .m-stat {
        flex: 1;
        padding: 0.5rem 0.6rem;
        background: var(--bh-surface-2);
        border-radius: 9px;
    }

    .m-value {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.2;
        color: var(--bh-ink-900);
        font-variant-numeric: tabular-nums;
    }

    .m-label {
        margin-top: 0.1rem;
        font-size: 0.72rem;
        color: var(--bh-ink-400);
    }

    /* ---------- 捷径卡片（每日卡片 / 题库） ---------- */
    .daily-card-shortcut {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem 1.15rem;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
        text-decoration: none;
        color: inherit;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .daily-card-shortcut:hover {
        border-color: var(--bh-brand-500);
        box-shadow: var(--bh-shadow-md);
        transform: translateY(-2px);
    }

    .shortcut-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        font-size: 1.35rem;
        background: var(--bh-brand-50);
        border: 1px solid var(--bh-brand-100);
        border-radius: 12px;
    }

    .shortcut-text {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .shortcut-title {
        font-size: 0.98rem;
        font-weight: 650;
        color: var(--bh-ink-900);
    }

    .shortcut-desc {
        font-size: 0.83rem;
        color: var(--bh-ink-500);
    }

    .shortcut-arrow {
        font-size: 1.5rem;
        line-height: 1;
        color: var(--bh-ink-300);
        transition: color 0.16s ease, transform 0.16s ease;
    }

    .daily-card-shortcut:hover .shortcut-arrow {
        color: var(--bh-brand-600);
        transform: translateX(2px);
    }

    /* ---------- 排行榜预览 ---------- */
    .leaderboard-preview {
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
        padding: 0.35rem 1rem;
    }

    .leaderboard-row {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid var(--bh-border);
    }

    .leaderboard-row:last-child { border-bottom: none; }

    .lb-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        flex: 0 0 28px;
        border-radius: 50%;
        font-size: 0.95rem;
        color: #fff;
    }

    .lb-name {
        flex: 1;
        min-width: 0;
        color: var(--bh-ink-700);
        font-weight: 500;
        font-size: 0.9rem;
    }

    .lb-score {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--bh-ink-500);
        font-variant-numeric: tabular-nums;
    }

    .section-empty {
        padding: 1.4rem;
        text-align: center;
        color: var(--bh-ink-400);
        font-size: 0.88rem;
        background: var(--bh-surface-2);
        border-radius: 10px;
    }

    /* ---------- Onboarding 向导 ---------- */
    .onboarding-wizard { max-width: 560px; margin: 2rem auto; }
    .onboarding-header { text-align: right; margin-bottom: 0.5rem; }

    .onboarding-skip {
        background: none;
        border: none;
        color: var(--bh-ink-400);
        cursor: pointer;
        font-size: 0.85rem;
    }

    .onboarding-skip:hover { color: var(--bh-ink-700); }

    .onboarding-card {
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        padding: 2rem 1.75rem;
        text-align: center;
        box-shadow: var(--bh-shadow-md);
    }

    .onboarding-card h2 {
        font-size: 1.25rem;
        font-weight: 650;
        margin-bottom: 0.5rem;
        color: var(--bh-ink-900);
    }

    .onboarding-card p { color: var(--bh-ink-500); font-size: 0.9rem; margin-bottom: 1.25rem; }

    .onboarding-form { display: flex; flex-direction: column; gap: 0.75rem; max-width: 320px; margin: 0 auto; }

    .onboarding-error { color: var(--bh-danger); font-size: 0.82rem; margin: 0; }

    .onboarding-steps { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.25rem; }

    .ob-step {
        font-size: 0.78rem;
        color: var(--bh-ink-400);
        padding: 0.28rem 0.7rem;
        border-radius: 20px;
        background: var(--bh-surface-3);
    }

    .ob-step.active { color: #fff; background: var(--bh-brand-600); font-weight: 600; }

    /* ---------- 响应式 ---------- */
    @@media (max-width: 768px) {
        .family-landing { padding: 0.85rem 0.6rem 2rem; }
        .family-summary { grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
        .summary-card { padding: 0.8rem; gap: 0.7rem; }
        .summary-icon { width: 38px; height: 38px; flex-basis: 38px; font-size: 1.15rem; }
        .summary-value { font-size: 1.3rem; }
        .member-snapshot { grid-template-columns: 1fr; }
        .daily-card-shortcut { padding: 0.85rem; }
        .shortcut-icon { width: 38px; height: 38px; flex-basis: 38px; font-size: 1.15rem; }
        .onboarding-card { padding: 1.4rem 1.1rem; }
        .onboarding-steps { flex-wrap: wrap; gap: 0.4rem; }
    }

    @@media (min-width: 769px) and (max-width: 1024px) {
        .family-landing { max-width: 100%; }
    }
</style>

@code {
    private List<Baihua.Contracts.Achievements.LearnerDto> learners = new();
    private DashboardDataDto data = new();
    private List<LeaderboardEntryDto> leaderboardEntries = new();
    private bool isLoading = true;

    // FAM-34 Onboarding
    private bool showOnboarding = false;
    private int onboardingStep = 1;
    private string newLearnerName = "";
    private string onboardingError = "";
    private bool isOnboardingBusy = false;

    private int todayTotal => data.FamilyStats.Sum(s => s.WeekTotal);
    private int maxStreak => data.FamilyStats.Count > 0 ? data.FamilyStats.Max(s => s.Streak) : 0;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("FamilyLanding OnInitializedAsync enter");
        try
        {
            await LoadLandingAsync();
            Logger.LogInformation("FamilyLanding OnInitializedAsync done");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FamilyLanding OnInitializedAsync exception");
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadLandingAsync()
    {
        Logger.LogInformation("FamilyLanding LoadLandingAsync start");
        try
        {
            learners = await ApiService.GetLearnersAsync();
            Logger.LogInformation("FamilyLanding learners count={Count}", learners.Count);
            // FAM-34 AC1/AC4：无 Learner 且 Onboarding 未完成（且无使用痕迹）才触发
            if (learners.Count == 0)
            {
                var onboarding = await ApiService.GetOnboardingStatusAsync();
                showOnboarding = !onboarding.IsOnboardingCompleted;
                if (showOnboarding)
                {
                    onboardingStep = 1;
                    isLoading = false;
                    return;
                }
            }

            var vaults = await VaultsService.GetVaultsAsync();
            var vaultId = vaults.Vaults.FirstOrDefault()?.Id;
            data = await ApiService.GetDashboardAsync(vaultId);
            leaderboardEntries = await ApiService.GetLeaderboardAsync("weekly", vaultId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载家庭首页失败");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateLearnerFromOnboarding()
    {
        if (string.IsNullOrWhiteSpace(newLearnerName))
        {
            onboardingError = L["FamilyLanding_NameRequired"].Value;
            return;
        }
        if (newLearnerName.Trim().Length > 20)
        {
            onboardingError = L["FamilyLanding_NameTooLong"].Value;
            return;
        }
        isOnboardingBusy = true;
        onboardingError = "";
        try
        {
            await ApiService.CreateLearnerAsync(new Baihua.Contracts.Achievements.CreateLearnerRequest
            {
                Name = newLearnerName.Trim(),
                AvatarEmoji = "😊",
                Color = "var(--bh-brand-500)"
            });
            onboardingStep = 2;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Onboarding 创建学习者失败");
            onboardingError = L["FamilyLanding_CreateFailed"].Value;
        }
        finally
        {
            isOnboardingBusy = false;
        }
    }

    private async Task SkipOnboarding()
    {
        // FAM-34 AC3：跳过后持久化 OnboardingCompleted，不再弹出
        await ApiService.CompleteOnboardingAsync();
        showOnboarding = false;
        await LoadLandingAsync();
    }
}
