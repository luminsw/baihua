    private bool showListeningModal = false;
    private string listeningVaultId = "";
    private string listeningVaultName = "";
    private List<(string Path, string Title, string? Content, string Category)> listeningPlaylist = new();
    private int listeningCurrentIndex = 0;
    private bool isPlaying = false;
    private HashSet<int> playedIndices = new();

    // 发送知识库到设备（多选 + 弹窗）
    private HashSet<string> selectedVaultIds = new();
    private bool showSendModal = false;
    private bool isLoadingDevices = false;
    private List<AuthorizedDeviceDto> sendDevices = new();
    private HashSet<string> selectedDeviceIds = new();
    private bool isSending = false;
    private string? sendResultMessage = null;
    private bool sendResultSuccess = false;

    private void ToggleVaultSelection(string vaultId)
    {
        if (!selectedVaultIds.Remove(vaultId))
        {
            selectedVaultIds.Add(vaultId);
