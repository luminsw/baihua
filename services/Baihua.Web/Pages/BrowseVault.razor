    private async Task StartListening(string vaultId, string vaultName)
    {
        try
        {
            listeningVaultId = vaultId;
            listeningVaultName = vaultName;
            listeningPlaylist = new List<(string Path, string Title, string? Content, string Category)>();
            listeningCurrentIndex = 0;
            isPlaying = false;
            playedIndices.Clear();
            listeningError = "";

            var batch = await ApiService.GetVaultNotesBatchAsync(vaultId);
            if (batch?.Notes != null)
            {
                foreach (var note in batch.Notes)
                {
                    var category = ExtractCategory(note.Path);
                    listeningPlaylist.Add((note.Path, note.Title, note.Content, category));
                }
            }

            if (listeningPlaylist.Count > 0)
            {
                if (ttsVoices.Count == 0)
                {
                    ttsVoices = await ApiService.GetTtsVoicesAsync() ?? new();
                }
                showListeningModal = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "StartListening failed");
        }
        await InvokeAsync(StateHasChanged);
    }

    private DotNetObjectReference<BrowseVault>? _dotNetRef = null;
    private int _speakSeq = 0; // 递增序号，防止过快的 onend 回调导致无限循环
    private bool _isPlayingSpeech = false; // 防止 OnSpeechEnded 重入
    private string listeningError = "";
    private List<TtsVoice> ttsVoices = new();
    private string selectedVoice = "zf_xiaoxiao";

    /// <summary>剥离 YAML frontmatter（AI 生成的笔记含 ai_provider/ai_model 等元数据，朗读/展示不应出现）</summary>
    private static string StripFrontmatter(string content)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(content)) return content ?? "";
            var trimmed = content.TrimStart();
            if (!trimmed.StartsWith("---", StringComparison.Ordinal)) return content;
            var end = trimmed.IndexOf("\n---", StringComparison.Ordinal);
            if (end < 0) return content;
            var after = trimmed[(end + 4)..];
            return after.TrimStart('\r', '\n');
        }
        catch
        {
            // 极端输入兜底：剥离失败就原样返回，绝不影响朗读/展示
            return content;
        }
    }

    [JSInvokable]
    public async Task OnSpeechFailed(int seq, string message)
    {
        if (seq != _speakSeq) return;
        // 防重入：只有正在播放时才处理失败（避免与 OnSpeechEnded 双重回调竞争）
        if (!_isPlayingSpeech) return;
        _speakSeq++; // 使后续回调失效
        _isPlayingSpeech = false;
        isPlaying = false;
        listeningError = message;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TogglePlayPause()
    {
        if (isPlaying)
        {
            await StopPlaying();
        }
        else
        {
            await PlayCurrentNote();
        }
    }

    private async Task JumpToNote(int index)
    {
        listeningCurrentIndex = index;
        playedIndices.Add(index);
        await PlayCurrentNote();
    }

    private async Task PlayCurrentNote()
    {
        if (listeningCurrentIndex >= listeningPlaylist.Count)
        {
            isPlaying = false;
            _isPlayingSpeech = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _speakSeq++;
        var currentSeq = _speakSeq;
        _isPlayingSpeech = true;
        playedIndices.Add(listeningCurrentIndex);

        var item = listeningPlaylist[listeningCurrentIndex];
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var textToSpeak = $"{item.Title}. {StripMarkdown(StripFrontmatter(item.Content ?? ""))}";

            var audioBytes = await ApiService.SynthesizeSpeechAsync(textToSpeak, selectedVoice);
            if (audioBytes != null && audioBytes.Length > 44)
            {
                var base64 = Convert.ToBase64String(audioBytes);
                await JSRuntime.InvokeVoidAsync("playAudioFromBase64", base64, _dotNetRef, currentSeq);
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("speakText", textToSpeak, _dotNetRef, currentSeq);
            }
        }
        catch (Exception ex)
        {
            // 语音异常不允许打崩 Blazor circuit：记录日志、停止播放并提示
            Logger.LogWarning(ex, "TTS/speakText 调用失败");
            _speakSeq++;
            _isPlayingSpeech = false;
            isPlaying = false;
            listeningError = "语音播放失败：" + ex.Message;
            await InvokeAsync(StateHasChanged);
            return;
        }
        isPlaying = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSpeechEnded(int seq)
    {
        // 序号不匹配说明是旧的回调（用户已点击下一篇/暂停等），忽略
        if (seq != _speakSeq) return;
        
        // 防止重入
        if (!_isPlayingSpeech) return;
        _isPlayingSpeech = false;

        isPlaying = false;
        if (listeningCurrentIndex < listeningPlaylist.Count - 1)
        {
            listeningCurrentIndex++;
            await PlayCurrentNote();
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayNext()
    {
        if (listeningCurrentIndex < listeningPlaylist.Count - 1)
        {
            listeningCurrentIndex++;
            await PlayCurrentNote();
        }
        else
        {
            isPlaying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayPrev()
    {
        if (listeningCurrentIndex > 0)
        {
            listeningCurrentIndex--;
            await PlayCurrentNote();
        }
    }

    private async Task StopPlaying()
    {
        _speakSeq++; // 使正在进行的 OnSpeechEnded 回调失效
        _isPlayingSpeech = false;
        await JSRuntime.InvokeVoidAsync("stopSpeaking");
        isPlaying = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseListening()
    {
        await StopPlaying();
        showListeningModal = false;
        listeningPlaylist.Clear();
        playedIndices.Clear();
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private async Task OnListeningKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseListening();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (isPlaying)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("stopSpeaking");
            }
            catch { }
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    private static string ExtractCategory(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var normalized = path.Replace('\\', '/');
        var lastSlash = normalized.LastIndexOf('/');
        if (lastSlash <= 0) return "";
        var dir = normalized.Substring(0, lastSlash);
        var parts = dir.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 ? string.Join(" / ", parts) : "";
    }

    private static readonly System.Text.RegularExpressions.Regex _reCodeBlock = new(@"```[\s\S]*?```", System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reInlineCode = new(@"`[^`]+`", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reTableSep = new(@"^\|[\s:|-]+\|$", System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reTableRow = new(@"^\|(.+)\|$", System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reWikiLink = new(@"\[\[([^\]]*\/)?([^\]]+)\]\]", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reMdLink = new(@"\[([^\]]+)\]\([^)]+\)", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reUrl = new(@"https?://\S+", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reImage = new(@"!\[[^\]]*\]\([^)]+\)", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reHeading = new(@"^#{1,6}\s+", System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reBlockquote = new(@"^>\s*", System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reBold1 = new(@"\*\*(.+?)\*\*", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reBold2 = new(@"__(.+?)__", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reItalic1 = new(@"\*(.+?)\*", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reItalic2 = new(@"_(.+?)_", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reStrike = new(@"~~(.+?)~~", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reHtml = new(@"<[^>]+>", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reHr = new(@"^[-*_]{3,}\s*$", System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex _reMultiNewline = new(@"\n{3,}", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string StripMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";

        var result = markdown;

        result = _reCodeBlock.Replace(result, "");
        result = _reInlineCode.Replace(result, m => m.Value.Trim('`'));
        result = _reTableSep.Replace(result, "");
        result = _reTableRow.Replace(result, m =>
        {
            var cells = m.Groups[1].Value.Split('|');
            return string.Join("，", cells.Select(c => c.Trim()).Where(c => !string.IsNullOrWhiteSpace(c)));
        });
        result = _reWikiLink.Replace(result, "$2");
        result = _reMdLink.Replace(result, "$1");
        result = _reUrl.Replace(result, "");
        result = _reImage.Replace(result, "");
        result = _reHeading.Replace(result, "");
        result = _reBlockquote.Replace(result, "");
        result = _reBold1.Replace(result, "$1");
        result = _reBold2.Replace(result, "$1");
        result = _reItalic1.Replace(result, "$1");
        result = _reItalic2.Replace(result, "$1");
        result = _reStrike.Replace(result, "$1");
        result = _reHtml.Replace(result, "");
        result = _reHr.Replace(result, "");
        result = _reMultiNewline.Replace(result, "\n\n");
        result = result.Trim();

        return result;
    }

    private void OpenInDetailPage()
    {
        if (selectedNoteItem == null) return;
        var vaultParam = string.IsNullOrEmpty(selectedVaultId) ? "" : $"&vaultId={Uri.EscapeDataString(selectedVaultId)}";
        Navigation.NavigateTo($"note?id={Uri.EscapeDataString(selectedNoteItem.Path)}{vaultParam}");
    }


    private static string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "";
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return Markdown.ToHtml(markdown, pipeline);
    }
}

