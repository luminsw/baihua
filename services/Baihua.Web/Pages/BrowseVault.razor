        .Where(v => selectedTags.Count == 0 || (v.Tags != null && selectedTags.All(tag => v.Tags.Contains(tag))))
        .Where(v => selectedSources.Count == 0 || selectedSources.Contains(string.IsNullOrWhiteSpace(v.Source) ? "local" : v.Source))
        .ToList();

