    private async Task OpenSendModal()
    {
        showSendModal = true;
        isLoadingDevices = true;
        selectedDeviceIds.Clear();
        try
        {
            sendDevices = await DevicesService.GetAuthorizedDevicesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载已授权设备列表失败");
            sendDevices = new List<AuthorizedDeviceDto>();
        }
        isLoadingDevices = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseSendModal()
    {
        showSendModal = false;
    }

    private async Task ConfirmSendVaults()
    {
        if (isSending || selectedDeviceIds.Count == 0 || selectedVaultIds.Count == 0) return;

        isSending = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (ok, result, message) = await DevicesService.SendVaultsToDevicesAsync(
                selectedDeviceIds.ToList(), selectedVaultIds.ToList());

            if (ok && result != null && result.DeliveredDeviceIds.Count > 0)
            {
                var skipped = result.SkippedDeviceIds.Count;
                sendResultMessage = skipped > 0
                    ? L["BrowseVault_SendPartial", result.DeliveredDeviceIds.Count, skipped].Value
                    : L["BrowseVault_SendSuccess", result.DeliveredDeviceIds.Count].Value;
                sendResultSuccess = true;
                selectedVaultIds.Clear();
                showSendModal = false;
            }
            else if (ok && result != null)
            {
                // 全部目标设备都离线（送达 0 台）
                sendResultMessage = L["BrowseVault_NoOnlineDevices"].Value;
                sendResultSuccess = false;
                showSendModal = false;
            }
            else
            {
                sendResultMessage = message ?? L["BrowseVault_SendFailed", "未知错误"].Value;
                sendResultSuccess = false;
                showSendModal = false;
            }
        }
        finally
        {
            isSending = false;
            await InvokeAsync(StateHasChanged);
        }
    }


