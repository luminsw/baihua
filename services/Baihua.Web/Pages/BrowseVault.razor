@page "/browse"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IApiService ApiService
@inject VaultsService VaultsService
@inject DevicesService DevicesService
@inject NavigationManager Navigation
@inject ILogger<BrowseVault> Logger
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject Baihua.Web.Services.IRecentNotesService RecentNotesService
@using Markdig
@using Microsoft.JSInterop
@using Baihua.Contracts.Vaults
@using Baihua.Contracts.Ai
@using Baihua.Contracts.Devices
@using Baihua.Web.Services
@implements IAsyncDisposable

<PageTitle>@L["BrowseVault_PageTitle"]</PageTitle>

<div class="container mt-4 browse-page">
    <div class="bh-page-header">
        <div>
            <h1 class="bh-page-title"><span class="bh-page-emoji">🗂️</span>@L["BrowseVault_Title"]</h1>
            <p class="bh-page-sub">按行业、标签与来源筛选知识库，点开即可阅读笔记。</p>
        </div>
    </div>

    <!-- 最近浏览 -->
    @if (!isLoadingRecentNotes && recentNotes?.Any() == true)
    {
        <div class="mb-4">
            <h5 class="mb-2 text-muted">@L["FamilyHome_RecentNotes"]</h5>
            <div class="recent-notes-inline">
                @foreach (var note in recentNotes.Take(6))
                {
                    <div class="note-chip" @onclick="() => NavigateToNote(note.Path)">
                        <span class="chip-title">@note.Title</span>
                        <span class="chip-meta">📁 @note.Path</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (isLoadingVaults)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">@L["Common_Loading"]</p>
        </div>
    }
    else if (vaults.Count == 0)
    {
        <div class="alert alert-info">
            @L["BrowseVault_NoVaultsPrefix"]<a href="vaults" class="alert-link">@L["BrowseVault_CreateOrImportVault"]</a>。
        </div>
    }
    else if (string.IsNullOrEmpty(selectedVaultId))
    {
        <!-- 行业过滤栏 -->
        @if (allIndustries.Count > 0)
        {
            <div class="filter-bar">
                <span class="filter-label">@L["BrowseVault_IndustryLabel"]</span>
                <button class="filter-chip @(selectedIndustries.Count == 0 ? "active" : "")" @onclick="ClearIndustryFilter">
                    @L["BrowseVault_AllIndustries"]
                </button>
                @foreach (var industry in allIndustries)
                {
                    <button class="filter-chip @(selectedIndustries.Contains(industry) ? "active" : "")" @onclick="() => ToggleIndustryFilter(industry)">
                        @industry
                    </button>
                }
            </div>
        }

        <!-- 标签过滤栏 -->
        @if (allTags.Count > 0)
        {
            <div class="filter-bar">
                <span class="filter-label">@L["BrowseVault_TagLabel"]</span>
                <button class="filter-chip @(selectedTags.Count == 0 ? "active" : "")" @onclick="ClearTagFilter">
                    @L["BrowseVault_AllTags"]
                </button>
                @foreach (var tag in allTags)
                {
                    <button class="filter-chip @(selectedTags.Contains(tag) ? "active" : "")" @onclick="() => ToggleTagFilter(tag)">
                        @tag
                    </button>
                }
            </div>
        }

        <!-- 来源过滤栏 -->
        @if (allSources.Count > 0)
        {
            <div class="filter-bar">
                <span class="filter-label">@L["BrowseVault_SourceLabel"]</span>
                <button class="filter-chip @(selectedSources.Count == 0 ? "active" : "")" @onclick="ClearSourceFilter">
                    @L["BrowseVault_AllSources"]
                </button>
                @foreach (var source in allSources)
                {
                    <button class="filter-chip @(selectedSources.Contains(source) ? "active" : "")" @onclick="() => ToggleSourceFilter(source)">
                        @(source == "mobile" ? L["BrowseVault_MobilePush"] : L["BrowseVault_Local"])
                    </button>
                }
                @if (selectedIndustries.Count > 0 || selectedTags.Count > 0 || selectedSources.Count > 0)
                {
                    <button class="filter-clear" @onclick="ClearAllFilters">清除全部筛选</button>
                }
            </div>
        }

        <!-- 多选工具栏 + 发送结果提示 -->
        @if (selectedVaultIds.Count > 0)
        {
            <div class="mb-3 d-flex flex-wrap gap-2 align-items-center p-2 rounded send-toolbar">
                <span class="small">@L["BrowseVault_SelectedCount", selectedVaultIds.Count]</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearVaultSelection">
                    @L["BrowseVault_ClearSelection"]
                </button>
                <button class="btn btn-sm btn-primary" @onclick="OpenSendModal">
                    @L["BrowseVault_SendToDevice"]
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(sendResultMessage))
        {
            <div class="alert @(sendResultSuccess ? "alert-success" : "alert-warning") alert-dismissible fade show py-2">
                @sendResultMessage
                <button type="button" class="btn-close" @onclick="() => sendResultMessage = null"></button>
            </div>
        }

        <!-- 知识库列表（文件夹卡片形式） -->
        <div class="row g-3">
            @foreach (var v in FilteredVaults)
            {
                <div class="col-md-3 col-sm-4 col-6">
                    <div class="card h-100 vault-folder-card position-relative @(selectedVaultIds.Contains(v.Id) ? "vault-card-selected" : "")">
                        <input type="checkbox" class="form-check-input vault-select-check"
                               checked="@selectedVaultIds.Contains(v.Id)"
                               @onclick="() => ToggleVaultSelection(v.Id)"
                               title="@L["BrowseVault_SendToDevice"]" />
                        <div class="card-body text-center py-3">
                            <div class="fs-2 mb-1 vault-card-icon" @onclick="() => SelectVault(v.Id)">📚</div>
                            <div class="fw-bold text-truncate" @onclick="() => SelectVault(v.Id)" style="cursor:pointer;">@v.Name</div>
                            <div class="mt-1 d-flex flex-wrap justify-content-center gap-1">
                                @if (v.Source == "mobile")
                                {
                                    <span class="badge bg-info" style="font-size: 0.6em;">@L["BrowseVault_MobilePush"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border" style="font-size: 0.6em;">@L["BrowseVault_Local"]</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(v.Industry))
                                {
                                    <span class="badge bg-secondary" style="font-size: 0.6em;">@v.Industry</span>
                                }
                            </div>
                            @if (v.Tags?.Any() == true)
                            {
                                <div class="mt-1 d-flex flex-wrap justify-content-center gap-1">
                                    @foreach (var tag in v.Tags)
                                    {
                                        <span class="badge bg-secondary" style="font-size: 0.65em;">@tag</span>
                                    }
                                </div>
                            }
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartListening(v.Id, v.Name)" title="@L["BrowseVault_ListenTitle"]">
                                    @L["BrowseVault_Listen"]
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- 已选择知识库，显示面包屑 + 目录内容 -->
        <div class="d-flex align-items-center mb-3 gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="BackToVaultList">
                @L["BrowseVault_BackToList"]
            </button>
            <span class="text-muted">|</span>
            <strong>@currentVaultName</strong>
        </div>

        <!-- 面包屑 -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="javascript:void(0)" @onclick="GoToRoot">📁 @currentVaultName</a>
                </li>
                @if (!string.IsNullOrEmpty(currentPath))
                {
                    var parts = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
                    var acc = "";
                    for (int i = 0; i < parts.Length; i++)
                    {
                        acc = string.IsNullOrEmpty(acc) ? parts[i] : $"{acc}/{parts[i]}";
                        var localAcc = acc;
                        <li class="breadcrumb-item">
                            <a href="javascript:void(0)" @onclick="@(() => NavigateTo(localAcc))">@parts[i]</a>
                        </li>
                    }
                }
            </ol>
        </nav>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">@L["Common_Loading"]</p>
            </div>
        }
        else if (browseItems.Count == 0)
        {
            <div class="alert alert-light border">@L["BrowseVault_DirectoryEmpty"]</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in browseItems)
                {
                    <div class="col-md-3 col-sm-4 col-6">
                        @if (item.IsDirectory)
                        {
                            <div class="card h-100 vault-folder-card" @onclick="() => NavigateTo(item.Path)">
                                <div class="card-body text-center py-4">
                                    <div class="fs-1 mb-2">📁</div>
                                    <div class="fw-bold text-truncate">@item.Name</div>
                                    <small class="text-muted">@L["BrowseVault_Folder"]</small>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card h-100 vault-note-card" @onclick="() => OpenNote(item)">
                                <div class="card-body text-center py-4">
                                    <div class="fs-1 mb-2">📝</div>
                                    <div class="fw-bold text-truncate">@item.Name</div>
                                    <small class="text-muted">@item.Modified?.ToString("yyyy-MM-dd")</small>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

<!-- 笔记详情弹窗 -->
@if (showNoteModal && selectedNoteItem != null)
{
    <div class="modal fade show" style="display:block; background:rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">📝 @selectedNoteItem.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseNote"></button>
                </div>
                <div class="modal-body">
                    @if (noteContent == null)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else
                    {
                        @if (noteContent.AiGenerated)
                        {
                            <div class="mb-3 d-flex flex-wrap gap-1 align-items-center">
                                <span class="badge bg-info">@L["BrowseVault_AiGenerated"]</span>
                                @if (!string.IsNullOrEmpty(noteContent.AiProvider))
                                {
                                    <span class="badge bg-light text-dark border">@noteContent.AiProvider</span>
                                }
                                @if (!string.IsNullOrEmpty(noteContent.AiModel))
                                {
                                    <span class="badge bg-light text-dark border">@noteContent.AiModel</span>
                                }
                                @if (noteContent.GeneratedAt.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">@noteContent.GeneratedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                }
                            </div>
                        }
                        @if (noteContent.Tags?.Any() == true)
                        {
                            <div class="mb-3">
                                @foreach (var tag in noteContent.Tags)
                                {
                                    <span class="badge bg-secondary me-1">@tag</span>
                                }
                            </div>
                        }
                        <div class="note-markdown-content">
                            @((MarkupString)RenderMarkdown(noteContent.Content))
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseNote">@L["Common_Close"]</button>
                    <button class="btn btn-primary" @onclick="OpenInDetailPage">@L["BrowseVault_OpenInDetailPage"]</button>
                </div>
            </div>
        </div>
    </div>

}

<!-- 听知识库弹窗 -->
@if (showListeningModal)
{
    <div class="modal fade show" style="display:block; background:rgba(0,0,0,0.5);" tabindex="-1" @onkeydown="OnListeningKeyDown" @onkeydown:preventDefault>
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["BrowseVault_ListenVaultTitle", listeningVaultName]</h5>
                    <button type="button" class="btn-close" @onclick="CloseListening" aria-label="@L["Common_Close"]"></button>
                </div>
                <div class="modal-body">
                    @if (listeningPlaylist.Count == 0)
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">@L["BrowseVault_VaultNoNotes"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4 listen-current-card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">@(listeningCurrentIndex + 1) / @listeningPlaylist.Count</span>
                                <span class="badge @(isPlaying ? "bg-primary" : "bg-secondary")">@(isPlaying ? L["BrowseVault_Playing"] : L["BrowseVault_Paused"])</span>
                            </div>
                            <h4 style="margin-top:0;">@listeningPlaylist[listeningCurrentIndex].Title</h4>
                            <div class="listen-current-content">
                                @StripMarkdown(StripFrontmatter(listeningPlaylist[listeningCurrentIndex].Content ?? ""))
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(listeningError))
                        {
                            <div class="alert alert-warning py-2 small">⚠️ @listeningError</div>
                        }

                        @if (ttsVoices.Count > 0)
                        {
                            <div class="mb-3 d-flex align-items-center gap-2">
                                <label class="form-label mb-0 text-muted small">@L["BrowseVault_Voice"]</label>
                                <select class="form-select form-select-sm" style="width:auto;flex:1;" @bind="selectedVoice">
                                    @foreach (var v in ttsVoices)
                                    {
                                        <option value="@v.Id">@v.Name（@(v.Language == "zh" ? "中文" : "英文")・@(v.Gender == "female" ? "女" : "男")）</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="mb-3 d-flex justify-content-center gap-2">
                            <button class="btn btn-outline-secondary" @onclick="PlayPrev" disabled="@(listeningCurrentIndex == 0)">
                                @L["BrowseVault_Previous"]
                            </button>
                            <button class="btn btn-primary" @onclick="TogglePlayPause">
                                @(isPlaying ? L["BrowseVault_Pause"] : L["BrowseVault_Play"])
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="PlayNext" disabled="@(listeningCurrentIndex >= listeningPlaylist.Count - 1)">
                                @L["BrowseVault_Next"]
                            </button>
                        </div>

                        <div class="listen-playlist-container">
                            <div class="listen-playlist-header">@L["BrowseVault_Playlist"]</div>
                            @{
                                string? lastCategory = null;
                            }
                            @foreach (var (index, item) in listeningPlaylist.Select((item, index) => (index, item)))
                            {
                                @if (!string.IsNullOrEmpty(item.Category) && item.Category != lastCategory)
                                {
                                    lastCategory = item.Category;
                                    <div class="listen-category-header">📁 @item.Category</div>
                                }
                                <button @onclick="() => JumpToNote(index)" 
                                        class="playlist-item @(index == listeningCurrentIndex ? "playlist-active" : "")">
                                    <span style="display:flex;align-items:center;gap:6px;">
                                        @if (playedIndices.Contains(index) && index != listeningCurrentIndex)
                                        {
                                            <span class="listen-played-check">✓</span>
                                        }
                                        <span>@(index + 1).</span>
                                        <span>@item.Title</span>
                                    </span>
                                    @if (index == listeningCurrentIndex && isPlaying)
                                    {
                                        <span>▶</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseListening">@L["Common_Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 发送知识库到设备弹窗 -->
@if (showSendModal)
{
    <div class="modal fade show" style="display:block; background:rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["BrowseVault_SendToDeviceTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseSendModal" aria-label="@L["Common_Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-2">@L["BrowseVault_ChooseDevices"]</p>
                    @if (isLoadingDevices)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else if (sendDevices.Count == 0)
                    {
                        <div class="alert alert-info py-2 mb-0">@L["BrowseVault_NoOnlineDevices"]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var d in sendDevices)
                            {
                                <label class="list-group-item d-flex justify-content-between align-items-center @(d.IsOnline ? "" : "text-muted")">
                                    <span class="d-flex align-items-center gap-2">
                                        <input type="checkbox" class="form-check-input m-0"
                                               disabled="@(d.IsOnline ? (bool?)null : true)"
                                               checked="selectedDeviceIds.Contains(d.DeviceId)"
                                               @onchange="() => ToggleDeviceSelection(d.DeviceId)" />
                                        <span class="text-truncate">@d.DeviceName</span>
                                        @if (!string.IsNullOrEmpty(d.SystemDeviceName))
                                        {
                                            <small class="text-muted text-truncate">（@d.SystemDeviceName）</small>
                                        }
                                    </span>
                                    <span class="badge @(d.IsOnline ? "bg-success" : "bg-secondary")" style="font-size:0.7em;">
                                        @(d.IsOnline ? L["BrowseVault_DeviceOnline"] : L["BrowseVault_DeviceOffline"])
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseSendModal">@L["Common_Close"]</button>
                    <button class="btn btn-primary" disabled="@(isSending || selectedDeviceIds.Count == 0)" @onclick="ConfirmSendVaults">
                        @(isSending ? L["BrowseVault_Sending"] : L["BrowseVault_Send"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}


<style>
    /* 筛选条：统一为一组中性 chip，选中态用品牌色，不再是绿/蓝/灰混搭 */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .filter-label {
        min-width: 2.4rem;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--bh-ink-400);
        margin-right: 2px;
    }

    .filter-chip {
        border: 1px solid var(--bh-border-strong);
        background: var(--bh-surface);
        color: var(--bh-ink-500);
        border-radius: 999px;
        padding: 3px 12px;
        font-size: 0.82rem;
        line-height: 1.6;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .filter-chip:hover {
        border-color: var(--bh-brand-500);
        color: var(--bh-brand-600);
        background: var(--bh-brand-50);
    }

    .filter-chip.active {
        background: var(--bh-brand-600);
        border-color: var(--bh-brand-600);
        color: #fff;
        font-weight: 600;
    }

    .filter-clear {
        margin-left: auto;
        border: none;
        background: transparent;
        color: var(--bh-ink-400);
        font-size: 0.8rem;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
    }

    .filter-clear:hover { color: var(--bh-danger); }

    .vault-folder-card, .vault-note-card {
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius);
        box-shadow: var(--bh-shadow-xs);
    }
    .vault-select-check {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 1.05em;
        height: 1.05em;
        margin: 0;
        cursor: pointer;
        z-index: 1;
        accent-color: var(--bh-brand-600);
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    /* 未悬停、未选中时隐藏勾选框，避免满屏蓝方块；悬停或已选中时出现 */
    .vault-folder-card:hover .vault-select-check,
    .vault-folder-card:focus-within .vault-select-check,
    .vault-card-selected .vault-select-check,
    .vault-select-check:checked {
        opacity: 1;
    }

    .vault-card-icon {
        cursor: pointer;
        line-height: 1.15;
    }

    .vault-folder-card .btn-outline-primary {
        border-color: var(--bh-brand-100);
        color: var(--bh-brand-600);
        border-radius: 999px;
        font-size: 0.76rem;
        padding: 1px 12px;
    }

    .vault-folder-card .btn-outline-primary:hover {
        background: var(--bh-brand-600);
        border-color: var(--bh-brand-600);
        color: #fff;
    }

    /* 卡片内标签统一为柔和中性 chip，避免红/蓝/灰混杂 */
    .vault-folder-card .badge,
    .vault-note-card .badge {
        background: var(--bh-surface-3) !important;
        color: var(--bh-ink-500) !important;
        border: 1px solid var(--bh-border) !important;
        font-weight: 500;
        border-radius: 6px;
    }
    .vault-card-selected {
        border-color: var(--bh-brand-600);
        box-shadow: 0 0 0 2px rgba(46, 147, 181, 0.22);
    }
    .send-toolbar {
        background: var(--bh-brand-50);
        border: 1px solid var(--bh-brand-100);
    }
    [data-bs-theme="dark"] .send-toolbar {
        background: rgba(46, 147, 181, 0.12);
        border-color: rgba(46, 147, 181, 0.25);
    }
    .vault-folder-card:hover, .vault-note-card:hover {
        transform: translateY(-2px);
        border-color: var(--bh-border-strong);
        box-shadow: var(--bh-shadow-sm);
    }
    .vault-note-card {
        background: var(--bh-surface-2);
    }
    .note-markdown-content img {
        max-width: 100%;
        height: auto;
    }
    .note-markdown-content pre {
        background: #f5f5f5;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
    }
    .note-markdown-content code {
        background: #e8eef2;
        padding: 0.15rem 0.35rem;
        border-radius: 3px;
