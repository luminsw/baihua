@page "/generate"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Web
@using Baihua.Contracts.Generate
@inject NavigationManager Navigation
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.VaultsService VaultsService
@inject Microsoft.Extensions.Logging.ILogger<KnowledgeGenerate> Logger
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization

<PageTitle>@L["KnowledgeGen_PageTitle"]</PageTitle>

<h1>@L["KnowledgeGen_Title"]</h1>

<p class="text-muted mb-3">@L["KnowledgeGen_Subtitle"]</p>

@if (isInitializing)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["KnowledgeGen_LoadingVisuallyHidden"]</span>
        </div>
        <p class="mt-3 text-muted">@L["KnowledgeGen_LoadingConfig"]</p>
    </div>
}
else
{
    <div class="generate-section">
        <!-- Topic/Query Input (Top) -->
        <div class="form-group">
            <label>
                @(generationMode == "vault" ? L["KnowledgeGen_TopicLabel"] : L["KnowledgeGen_QueryLabel"])
            </label>
            @if (generationMode == "vault")
            {
                <input type="text" @bind="aiQuery" class="form-control" placeholder="@L["KnowledgeGen_TopicPlaceholder"]" />
                <div class="form-text">@L["KnowledgeGen_TopicHint"]</div>
            }
            else
            {
                <textarea @bind="aiQuery" @bind:event="oninput" class="form-control" rows="4"
                          placeholder="@L["KnowledgeGen_QueryPlaceholder"]"></textarea>
                <div class="form-text">@L["KnowledgeGen_QueryHint"]</div>
            }
        </div>

        <!-- 灵感主题（AI 每日推荐，点击填入主题框） -->
        <div class="form-group">
            <label>💡 @L["KnowledgeGen_TopicInspirationLabel"] <small class="text-muted fw-normal">@L["KnowledgeGen_TopicClickHint"]</small></label>
            @if (topicsLoading)
            {
                <div class="text-muted small py-2">
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    @L["KnowledgeGen_TopicLoading"]
                </div>
            }
            else if (topicSuggestions.Count > 0)
            {
                <div class="topic-grid">
                    @foreach (var s in topicSuggestions)
                    {
                        <button type="button" class="topic-card" @onclick="() => ApplyTopic(s)" title="@s.Description">
                            <span class="topic-cat">@s.Category</span>
                            <span class="topic-title">@s.Title</span>
                            <span class="topic-desc">@s.Description</span>
                        </button>
                    }
                </div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <small class="text-muted">@string.Format(L["KnowledgeGen_TopicsSourceFormat"], topicsSource == "ai" ? L["KnowledgeGen_SourceAi"] : L["KnowledgeGen_SourceBuiltin"])</small>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshTopics" disabled="@topicsLoading">🔄 @L["KnowledgeGen_RefreshTopics"]</button>
                </div>
            }
        </div>

        <!-- Generation Mode Selection -->
        <div class="form-group">
            <label>@L["KnowledgeGen_GenerationModeLabel"]</label>
            <div class="btn-group" role="group">
                <button class="btn @(generationMode == "vault" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => generationMode = "vault"'>
                    @L["KnowledgeGen_GenerateFullVault"]
                </button>
                <button class="btn @(generationMode == "note" ? "btn-primary" : "btn-outline-primary")"
                        @onclick='() => generationMode = "note"'>
                    @L["KnowledgeGen_GenerateSingleNote"]
                </button>
            </div>
        </div>

        <!-- Industry Selection (AI auto-infer + manual input) -->
        <div class="form-group">
            <label>@L["KnowledgeGen_IndustryLabel"]</label>
            <div class="d-flex flex-wrap gap-1 mb-2">
                <button class="btn @(string.IsNullOrEmpty(selectedIndustry) && !manualIndustryMode ? "btn-primary" : "btn-outline-primary") btn-sm"
                        @onclick="SelectAutoIndustry">
                    @L["KnowledgeGen_AiAutoInfer"]
                </button>
                @foreach (var industry in GetIndustryOptions())
                {
                    <button class="btn @(!manualIndustryMode && selectedIndustry == industry ? "btn-primary" : "btn-outline-primary") btn-sm"
                            @onclick="() => OnIndustryChanged(industry)">
                        @industry
                    </button>
                }
                <button class="btn @(manualIndustryMode ? "btn-primary" : "btn-outline-secondary") btn-sm"
                        @onclick="EnableManualIndustry">
                    @L["KnowledgeGen_Custom"]
                </button>
            </div>
            @if (manualIndustryMode)
            {
                <input type="text" class="form-control form-control-sm" @bind="manualIndustryValue" @bind:event="oninput"
                       @bind:after="SyncManualIndustry"
                       placeholder="@L["KnowledgeGen_CustomIndustryPlaceholder"]" style="max-width: 250px;" />
            }
            else if (string.IsNullOrEmpty(selectedIndustry))
            {
                <div class="form-text text-info">@L["KnowledgeGen_AutoInferHint"]</div>
            }
        </div>

        <!-- AI Model Selection -->
        @if (aiProviders.Count > 0)
        {
            <div class="form-group">
                <label>@L["KnowledgeGen_AiModelLabel"]</label>
                <div class="ai-model-selector">
                    @foreach (var provider in aiProviders)
                    {
                        <div style="font-size: 0.85rem; color: #666; margin-bottom: 0.25rem;">
                            @provider.Name @(provider.IsMain ? L["KnowledgeGen_MainSuffix"] : "")
                        </div>
                        <div class="model-options">
                            @foreach (var model in provider.Models)
                            {
                                var modelName = model.Name;
                                var displayName = modelName.Split('/').LastOrDefault() ?? modelName;
                                <button type="button"
                                        class="model-option @(selectedModel == modelName ? "selected" : "")"
                                        @onclick="() => SelectModel(modelName)"
                                        title="@modelName">
                                    @displayName

                                    @if (model.IsMain)
                                    {
                                        <span class="tag tag-default" style="margin-left: 0.3rem;">@L["KnowledgeGen_DefaultTag"]</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Vault Selection -->
        <div class="form-group">
            <label>@L["KnowledgeGen_TargetVaultLabel"]</label>
            <div class="vault-selector">
                <select class="form-select form-select-sm" @bind="selectedVaultId">
                    @foreach (var vault in GetFilteredVaults())
                    {
                        <option value="@vault.Id">@vault.Name</option>
                    }
                    @if (!string.IsNullOrEmpty(vaultRootPath))
                    {
                        <option value="__new__">@L["KnowledgeGen_NewVaultOption"]</option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(selectedVaultId) && selectedVaultId != "__new__")
                {
                    var selectedVault = GetFilteredVaults().FirstOrDefault(v => v.Id == selectedVaultId);
                    @if (selectedVault?.Tags?.Any() == true)
                    {
                        <div class="d-flex flex-wrap gap-1 align-items-center mt-2">
                            @foreach (var tag in selectedVault.Tags)
                            {
                                <span class="badge bg-info text-dark" style="font-size: 0.7em;">@tag</span>
                            }
                        </div>
                    }
                }
                @if (!string.IsNullOrEmpty(vaultRootPath))
                {
                    <small class="text-muted mt-2 d-block">
                        @L["KnowledgeGen_VaultRootPath"]<code>@vaultRootPath</code>
                        @if (selectedVaultId == "__new__")
                        {
                            <span class="ms-2 text-info">@L["KnowledgeGen_NewVaultSubdirHint"]</span>
                        }
                    </small>
                }
                else if (GetFilteredVaults().Count == 0)
                {
                    <div class="alert alert-warning mt-2">
                        @L["KnowledgeGen_NoVaultsInIndustry_Prefix"]<a href="vaults" class="alert-link">@L["KnowledgeGen_ConfigureVaults"]</a>@L["KnowledgeGen_Or"]<a href="vaults" class="alert-link">@L["KnowledgeGen_SetRootPath"]</a>@L["KnowledgeGen_Dot"]
                    </div>
                }
            </div>
        </div>

        @if (selectedVaultId == "__new__")
        {
            <div class="new-vault-hint alert alert-info mb-3">
                <strong>@L["KnowledgeGen_NewVaultMode"]</strong>
                <small class="ms-2 text-muted">@L["KnowledgeGen_NewVaultModeDesc"]</small>
            </div>

            <!-- Generate Cards Option (new vault mode only) -->
            <div class="form-group">
                <label class="form-check-label">
                    <input type="checkbox" @bind="generateCards" class="form-check-input" />
                    @L["KnowledgeGen_AutoGenerateCards"]
                </label>
                <div class="form-text text-muted">@L["KnowledgeGen_AutoGenerateCardsHint"]</div>
            </div>

            <!-- 详细度档位（新知识库模式） -->
            <div class="form-group">
                <label class="form-label fw-bold">@L["KnowledgeGen_DetailLabel"]</label>
                @if (!string.IsNullOrEmpty(globalDetailLevel))
                {
                    <div class="form-text text-muted mb-2">@L["KnowledgeGen_FollowGlobalPrefix"]<b>@(globalDetailLevel == "concise" ? L["Settings_DetailConcise"] : globalDetailLevel == "comprehensive" ? L["Settings_DetailComprehensive"] : L["Settings_DetailBalanced"])</b>@L["KnowledgeGen_FollowGlobalSuffix"]</div>
                }
                <div class="d-flex gap-4 flex-wrap">
                    <label class="form-check">
                        <input type="radio" name="detailLevel" class="form-check-input"
                               checked="@(detailLevel == "concise")" @onchange='() => SetDetailLevel("concise")' />
                        <span class="form-check-label">@L["Settings_DetailConcise"]</span>
                        <small class="text-muted d-block">@L["KnowledgeGen_DetailCountConcise"]</small>
                    </label>
                    <label class="form-check">
                        <input type="radio" name="detailLevel" class="form-check-input"
                               checked="@(detailLevel == "balanced")" @onchange='() => SetDetailLevel("balanced")' />
                        <span class="form-check-label">@L["KnowledgeGen_DetailBalanced"]</span>
                        <small class="text-muted d-block">@L["KnowledgeGen_DetailCountBalanced"]</small>
                    </label>
                    <label class="form-check">
                        <input type="radio" name="detailLevel" class="form-check-input"
                               checked="@(detailLevel == "comprehensive")" @onchange='() => SetDetailLevel("comprehensive")' />
                        <span class="form-check-label">@L["Settings_DetailComprehensive"]</span>
                        <small class="text-muted d-block">@L["KnowledgeGen_DetailCountComprehensive"]</small>
                    </label>
                </div>
            </div>
        }

        <!-- Prompt Editor -->
        <div class="form-group">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => showPromptEditor = !showPromptEditor">
                @(showPromptEditor ? L["KnowledgeGen_CollapsePrompt"] : L["KnowledgeGen_EditPrompt"])
            </button>
        </div>

        @if (showPromptEditor)
        {
            <div class="form-group">
                <label>@L["KnowledgeGen_SystemPromptLabel"]</label>
                <textarea class="form-control" @bind="customSystemPrompt" rows="6"
                          placeholder="@L["KnowledgeGen_SystemPromptPlaceholder"]"></textarea>
                <div class="form-text">
                    @if (string.IsNullOrWhiteSpace(customSystemPrompt))
                    {
                        <span class="text-muted">@L["KnowledgeGen_UsingDefaultPrompt"]</span>
                    }
                    else
                    {
                        <span class="text-info">@L["KnowledgeGen_CustomPromptSuffix"]</span>
                    }
                </div>
            </div>
        }

        <!-- Generation Button -->
        <div class="form-actions">
            <button @onclick="ExecuteGeneration"
                    class="btn btn-primary btn-lg"
                    disabled="@(isProcessing || string.IsNullOrWhiteSpace(aiQuery) || string.IsNullOrWhiteSpace(selectedVaultId))"
                    title="@(string.IsNullOrWhiteSpace(aiQuery) ? L["KnowledgeGen_TitleNeedsQuery"] : string.IsNullOrWhiteSpace(selectedVaultId) ? L["KnowledgeGen_TitleNeedsVault"] : "") ">
                @if (isProcessing)
                {
                    <span>⏳ @processingStep...</span>
                }
                else if (generationMode == "vault")
                {
                    <span>@L["KnowledgeGen_GenerateVaultBtn"]@(generateCards ? L["KnowledgeGen_WithCards"] : "")</span>
                }
                else
                {
                    <span>@L["KnowledgeGen_GenerateNoteBtn"]@(generateCards ? L["KnowledgeGen_WithCards"] : "")</span>
                }
            </button>
        </div>
    </div>

    <!-- Cards Entry -->
    <div class="mt-3">
        <a href="cards" class="btn btn-outline-info">
            <span>@L["KnowledgeGen_ViewCards"]</span>
        </a>
    </div>
}

