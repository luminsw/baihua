    // 本地模型配置
    private string localModelDownloadDir = "";
    private string platformDefaultDownloadDir = "";

    private async Task LoadLocalModelConfigAsync()
    {
        try
        {
            var config = await ApiService.GetDownloadConfigAsync();
            if (config != null)
            {
                localModelDownloadDir = config.DownloadDirectory ?? "";
                platformDefaultDownloadDir = config.PlatformDefaultDirectory ?? "";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载本地模型配置失败");
        }

        // 兜底：当后端未返回默认下载目录时，前端计算用户主目录下的 baihua models 路径
        if (string.IsNullOrEmpty(platformDefaultDownloadDir))
        {
            platformDefaultDownloadDir = Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),
                ".baihua",
                "models");
        }
        if (string.IsNullOrEmpty(localModelDownloadDir))
        {
            localModelDownloadDir = platformDefaultDownloadDir;
        }
    }
