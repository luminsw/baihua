@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject Baihua.Web.Services.IRecentNotesService RecentNotesService
@inject Baihua.Web.Services.ISearchHistoryService SearchHistoryService
@inject Baihua.Web.Services.AIStatusService AIStatusService
@inject Baihua.Web.Services.VaultStatusService VaultStatusService
@inject Baihua.Web.Services.DevicesService DevicesService
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.SettingsService SettingsService
@inject Microsoft.Extensions.Logging.ILogger<FamilyHome> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<Baihua.Web.Localization.SharedResources> L

@using Baihua.Web.Services
@using Baihua.Web.Components
@using System.Net
@using System.Linq
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Http.Connections

<PageTitle>@L["FamilyHome_PageTitle"]</PageTitle>

<div class="home-container">
    <!-- 核心价值宣传语 -->
    <div class="core-value-banner">
        <span class="core-value-text">@L["FamilyHome_CoreValue"]</span>
    </div>

    <InitializationTasks @ref="_initTasks" OnTasksChanged="OnTasksChanged" />

    <!-- 配置提醒区域 -->
    <div class="config-alerts">
        @if (!isInitialLoading && aiStatus == null)
        {
            <div class="config-alert status-alert">
                <div class="alert-header">
                    <span class="alert-icon">ℹ️</span>
                    <span class="alert-title">@L["FamilyHome_StatusFetchFailed"]</span>
                </div>
            </div>
        }
        else if (!isInitialLoading && !aiStatus!.IsConfigured && !AIStatusService.IsServerProxyMode)
        {
            <div class="config-alert api-alert">
                <div class="alert-header">
                    <span class="alert-icon">⚠️</span>
                    <span class="alert-title">@L["FamilyHome_ApiKeyNotConfigured"]</span>
                </div>
                <div class="alert-content">
                    <p>@L["FamilyHome_ApiKeyNotConfiguredDesc"]</p>
                    <div class="alert-advice">
                        @((MarkupString)GetConfigurationAdviceHtml())
                    </div>
                    <button class="alert-button" @onclick="NavigateToSettings">
                        @L["FamilyHome_ConfigureNow"]
                    </button>
                </div>
            </div>
        }

        @if (!isInitialLoading && (!vaultStatus?.IsConfigured ?? true))
        {
            <div class="config-alert vault-alert">
                <div class="alert-header">
                    <span class="alert-icon">📁</span>
                    <span class="alert-title">@L["FamilyHome_VaultNotConfigured"]</span>
                </div>
                <div class="alert-content">
                    <p>@L["FamilyHome_VaultNotConfiguredDesc"]</p>
                    <div class="alert-advice">
                        @((MarkupString)GetVaultConfigurationAdviceHtml())
                    </div>
                    <button class="alert-button" @onclick="NavigateToVaults">
                        @L["FamilyHome_ConfigureNow"]
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- 花记设备集成 -->
    <div class="section">
        <h2 class="section-title">@L["Devices_Title"]</h2>

        <div class="device-stack">
            <!-- 扫码配对 -->
            <div class="card qr-card">
                <div class="card-header">
                    <h3>@L["Devices_ScanPair"]</h3>
                </div>
                <div class="card-body">
                    <QRToolPanel />
                </div>
            </div>

            <!-- 待授权设备 -->
            <div class="card pending-card">
                <div class="card-header">
                    <h3>@L["Devices_PendingDevices"]</h3>
                    @if (pendingDevices.Count > 0)
                    {
                        <span class="badge bg-warning text-dark">@pendingDevices.Count</span>
                    }
                </div>
                <div class="card-body">
                    @if (isLoadingDevices)
                    {
                        <div class="text-muted small">@L["Devices_Loading"]</div>
                    }
                    else if (!pendingDevices.Any())
                    {
                        <p class="text-muted mb-0">@L["Devices_NoPendingDevices"]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@L["Devices_ColDisplayName"]</th>
                                        <th>@L["Devices_ColDeviceName"]</th>
                                        <th>@L["Devices_ColIpAddress"]</th>
                                        <th>@L["Devices_ColRequestTime"]</th>
                                        <th>@L["Devices_ColActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var device in pendingDevices)
                                    {
                                        <tr>
                                            <td><strong>@device.DeviceName</strong></td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrEmpty(device.SystemDeviceName) ? "-" : device.SystemDeviceName)
                                            </td>
                                            <td class="text-muted small">@device.IpAddress</td>
                                            <td class="small">@device.RequestTime.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-sm btn-success" @onclick="() => AuthorizeDeviceAsync(device.RequestId)" disabled="@isProcessingDevice">@L["Devices_Authorize"]</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectDeviceAsync(device.RequestId)" disabled="@isProcessingDevice">@L["Devices_Reject"]</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- 已授权设备 -->
            <div class="card device-card">
                <div class="card-header">
                    <h3>@L["Devices_AuthorizedDevicesTitle"]</h3>
                    <span class="badge bg-success">@authorizedDevices.Count</span>
                </div>
                <div class="card-body">
                    @if (isLoadingDevices)
                    {
                        <div class="text-muted small">@L["Devices_Loading"]</div>
                    }
                    else if (!authorizedDevices.Any())
                    {
                        <p class="text-muted mb-0">@L["Devices_NoAuthorizedDevices"]</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@L["Devices_ColDisplayName"]</th>
                                        <th>@L["Devices_ColDeviceName"]</th>
                                        <th>@L["Devices_ColIpAddress"]</th>
                                        <th>@L["Devices_ColAuthorizedTime"]</th>
                                        <th>@L["Devices_ColActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var device in authorizedDevices)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@device.DeviceName</strong>
                                                <div class="text-muted small">@device.DeviceId</div>
                                            </td>
                                            <td class="text-muted small">
                                                @(string.IsNullOrEmpty(device.SystemDeviceName) ? "-" : device.SystemDeviceName)
                                            </td>
                                            <td class="text-muted small">@device.IpAddress</td>
                                            <td class="small">
                                                @(device.AuthorizedTime.HasValue ? device.AuthorizedTime.Value.ToLocalTime().ToString("MM-dd HH:mm") : "-")
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeDeviceAsync(device.DeviceId)" disabled="@isProcessingDevice">@L["Devices_Revoke"]</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

