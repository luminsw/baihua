@code {
    private class AuthorizedDeviceInfo
    {
        public string DeviceId { get; set; } = "";
        public string DeviceName { get; set; } = "";
        public string? SystemDeviceName { get; set; }
        public DateTime? AuthorizedTime { get; set; }
        public string IpAddress { get; set; } = "";
    }

    private class PendingDeviceInfo
    {
        public string RequestId { get; set; } = "";
        public string DeviceName { get; set; } = "";
        public string? SystemDeviceName { get; set; }
        public DateTime RequestTime { get; set; }
        public string IpAddress { get; set; } = "";
    }

    // DeviceHub 推送的 DeviceStatusChanged 事件负载（对应 DeviceService.NotifyDeviceStatusChangedAsync）
    private class DeviceStatusPayload
    {
        public string? Action { get; set; }
        public string? Type { get; set; }
        public string? DeviceName { get; set; }
        public string? RequestId { get; set; }
        public string? DeviceId { get; set; }
        public string? VaultId { get; set; }
        public string? VaultName { get; set; }
    }

    private List<AuthorizedDeviceInfo> authorizedDevices = new();
    private List<PendingDeviceInfo> pendingDevices = new();
    private bool isLoadingDevices = true;
    private bool isProcessingDevice;
    private InitializationTasks? _initTasks;
    private AIStatusSummary? aiStatus;
    private VaultStatusSummary? vaultStatus;
    private bool isInitialLoading = true;
    // SignalR 设备状态 Hub 连接（替代轮询，扫码后实时推送）
    private HubConnection? _deviceHub;
    private CancellationTokenSource _disposeCts = new();
    // 防抖：短时间内收到多次 DeviceStatusChanged 只刷新一次
    private CancellationTokenSource? _refreshDebounceCts;

    protected override void OnInitialized()
    {
        isInitialLoading = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _ = Task.Run(async () =>
        {
            try
            {
                var statusTask = AIStatusService.GetStatusSummaryAsync();
                var vaultTask = VaultStatusService.GetStatusSummaryAsync();
                var devicesTask = LoadDevicesAsync();
                await Task.WhenAll(statusTask, vaultTask, devicesTask);

                await InvokeAsync(() =>
                {
                    aiStatus = statusTask.Result;
                    vaultStatus = vaultTask.Result;
                    isInitialLoading = false;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "后台加载失败");
                await InvokeAsync(() =>
                {
                    isInitialLoading = false;
                    StateHasChanged();
                });
            }
        });

        // 连接 DeviceHub，监听设备状态变化（扫码注册/授权/拒绝等实时推送）
        _ = StartDeviceHubAsync();
    }

    private static bool IsLoopbackUrl(string baseUrl)
    {
        if (!Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri)) return true;
        return uri.Host is "127.0.0.1" or "localhost" or "::1";
    }

    private async Task StartDeviceHubAsync()
    {
        try
        {
            var backend = BaihuaEndpointHelper.NormalizeOutboundBaseUrl(SettingsService.BackendUrl);
            var pageBase = Navigation.BaseUri.TrimEnd('/');
            // k8s/代理场景：BackendUrl 是回环但页面不是 → 用页面同源让代理转发
            if (IsLoopbackUrl(backend) && !IsLoopbackUrl(pageBase))
            {
                backend = pageBase;
            }
            var hubUrl = $"{backend}/hubs/devices";

            _deviceHub = new HubConnectionBuilder()
                .WithUrl(hubUrl, o =>
                {
                    o.Transports = HttpTransportType.WebSockets;
                    o.SkipNegotiation = true;
                    o.HttpMessageHandlerFactory = _ => new SocketsHttpHandler
                    {
                        UseProxy = false,
                    };
                })
                .WithServerTimeout(TimeSpan.FromSeconds(60))
                .WithKeepAliveInterval(TimeSpan.FromSeconds(10))
                .WithAutomaticReconnect()
                .Build();

            // 仅响应授权状态变化（pair_request/authorized/revoked/rejected）；
            // 忽略 sync_updated（花记每次同步都会触发，会导致列表频繁刷新）
            _deviceHub.On<DeviceStatusPayload>("DeviceStatusChanged", async payload =>
            {
                if (payload?.Type == "SyncRequest" || payload?.Action == "sync_updated")
                {
                    return;
                }
                // 防抖 500ms，合并短时间内多次推送
                var cts = new CancellationTokenSource();
                var oldCts = System.Threading.Interlocked.Exchange(ref _refreshDebounceCts, cts);
                oldCts?.Cancel();
                try
                {
                    await Task.Delay(500, cts.Token);
                    if (_disposeCts.IsCancellationRequested) return;
                    await InvokeAsync(async () =>
                    {
                        await LoadDevicesAsync();
                        StateHasChanged();
                    });
                }
                catch (TaskCanceledException) { }
            });

            _deviceHub.Reconnecting += _ex => InvokeAsync(StateHasChanged);
            // 重连后不强制刷新列表：服务端 Clients.All 广播的事件会自动恢复接收，
            // 强制刷新反而在本次超时重连问题下表现为"每 15 秒自动刷新"
            _deviceHub.Reconnected += _connId => InvokeAsync(StateHasChanged);
            _deviceHub.Closed += _ex => InvokeAsync(StateHasChanged);

            using var budget = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            await _deviceHub.StartAsync(budget.Token);
            Logger.LogInformation("[FamilyHome] DeviceHub 已连接 {HubUrl}", hubUrl);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[FamilyHome] DeviceHub 连接失败");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposeCts.Cancel();
        _refreshDebounceCts?.Cancel();
        _refreshDebounceCts?.Dispose();
        _disposeCts.Dispose();
        if (_deviceHub != null)
        {
            try { await _deviceHub.DisposeAsync(); } catch { }
        }
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            isLoadingDevices = true;
            var pendingTask = DevicesService.GetPendingDevicesAsync();
            var authorizedTask = DevicesService.GetAuthorizedDevicesAsync();
            await Task.WhenAll(pendingTask, authorizedTask);

            var pendingResult = pendingTask.Result ?? new();
            var authorizedResult = authorizedTask.Result ?? new();

            pendingDevices = pendingResult.Select(d => new PendingDeviceInfo
            {
                RequestId = d.RequestId ?? "",
                DeviceName = d.DeviceName ?? L["Devices_UnknownDevice"],
                SystemDeviceName = d.SystemDeviceName,
                RequestTime = d.RequestTime != default ? d.RequestTime : DateTime.Now,
                IpAddress = d.IpAddress ?? ""
            }).ToList();

            authorizedDevices = authorizedResult.Select(d => new AuthorizedDeviceInfo
            {
                DeviceId = d.DeviceId ?? "",
                DeviceName = d.DeviceName ?? L["Devices_UnknownDevice"],
                SystemDeviceName = d.SystemDeviceName,
                AuthorizedTime = d.AuthorizedTime,
                IpAddress = d.IpAddress ?? ""
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载设备列表失败");
        }
        finally
        {
            isLoadingDevices = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToSettings()
    {
        Navigation.NavigateTo("settings");
    }

    private void NavigateToVaults()
    {
        Navigation.NavigateTo("vaults");
    }

    private async Task OnTasksChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task AuthorizeDeviceAsync(string requestId)
    {
        try
        {
            isProcessingDevice = true;
            var (success, msg) = await DevicesService.AuthorizeDeviceAsync(requestId);
            if (success)
            {
                await LoadDevicesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "授权设备失败");
        }
        finally
        {
            isProcessingDevice = false;
        }
    }

    private async Task RejectDeviceAsync(string requestId)
    {
        try
        {
            isProcessingDevice = true;
            var (success, msg) = await DevicesService.RejectDeviceAsync(requestId);
            if (success)
            {
                await LoadDevicesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "拒绝设备失败");
        }
        finally
        {
            isProcessingDevice = false;
        }
    }

    private async Task RevokeDeviceAsync(string deviceId)
    {
        try
        {
            isProcessingDevice = true;
            var (success, msg) = await DevicesService.RevokeDeviceAsync(deviceId);
            if (success)
            {
                await LoadDevicesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "撤销设备失败");
        }
        finally
        {
            isProcessingDevice = false;
        }
    }

    private string GetConfigurationAdviceHtml()
    {
        var advice = AIStatusService.GetConfigurationAdvice();
        if (string.IsNullOrEmpty(advice))
            advice = "";
        return advice
            .Replace("\n", "<br />")
            .Replace("• ", "&nbsp;&nbsp;• ");
    }

    private string GetVaultConfigurationAdviceHtml()
    {
        return VaultStatusService.GetConfigurationAdvice()
            .Replace("\n", "<br />")
            .Replace("• ", "&nbsp;&nbsp;• ");
    }
}
