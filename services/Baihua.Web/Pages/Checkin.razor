@page "/family/checkin"
@page "/checkin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Baihua.Web.Services.IApiService ApiService
@inject Baihua.Web.Services.VaultsService VaultsService
@inject Microsoft.Extensions.Logging.ILogger<Checkin> Logger
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@using Baihua.Contracts.Achievements

<PageTitle>@L["Checkin_Title"]</PageTitle>

<div class="checkin-page">
    <div class="bh-page-header">
        <div>
            <h1 class="bh-page-title"><span class="bh-page-emoji">🔥</span>@L["Checkin_Title"]</h1>
            <p class="bh-page-sub">连续打卡记录与最近 7 天的学习轨迹。</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-skeleton" aria-busy="true">
            <div class="skeleton skeleton-title"></div>
            <div class="skeleton skeleton-line"></div>
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
        </div>
    }
    else if (loadError)
    {
        <div class="checkin-error">
            <p class="error-text">@L["Checkin_LoadFailed"]</p>
            <button class="retry-btn" @onclick="LoadCheckinAsync">@L["Checkin_Retry"]</button>
        </div>
    }
    else
    {
        <!-- 连续打卡 + 最近 7 天日历 -->
        <section class="streak-section">
            <div class="streak-hero">
                <span class="streak-flame">🔥</span>
                <div class="streak-figure">
                    <span class="streak-num">@data.FamilyStreak</span>
                    <span class="streak-unit">@L["Checkin_StreakDays"]</span>
                </div>
                @if (data.StreakStatus == "今天还没学")
                {
                    <div class="streak-grace">@string.Format(L["Checkin_StreakGraceToday"], data.FamilyStreak)</div>
                }
                else if (!string.IsNullOrEmpty(data.StreakStatus))
                {
                    <div class="streak-grace">@data.StreakStatus</div>
                }
                @if (data.FamilyStreak >= 7)
                {
                    <div class="streak-motivation">@L["Checkin_StreakMotivation"]</div>
                }
            </div>
            <div class="calendar7">
                @foreach (var day in data.Last7Days)
                {
                    <div class="cal-cell @(day.IsToday ? "today" : "") @(day.IsChecked ? "checked" : "") @(day.IsMakeupable ? "makeupable" : "")"
                         title="@(day.Date?.ToString("MM-dd"))"
                         @onclick="() => TryOpenMakeup(day)">
                        <div class="cal-date">@(day.Date?.ToString("dd"))</div>
                        <div class="cal-mark">@(day.IsChecked ? "🔥" : "·")</div>
                        @if (day.IsMakeupable)
                        {
                            <span class="cal-makeup-hint">@L["Checkin_MakeupHint"]</span>
                        }
                    </div>
                }
            </div>
        </section>

        @if (showMakeupDialog)
        {
            <div class="makeup-dialog-mask" @onclick="CloseMakeupDialog">
                <div class="makeup-dialog" @onclick:stopPropagation="true">
                    <h3>@string.Format(L["Checkin_MakeupDialogTitle"], makeupTarget?.ToString("M月d日"))</h3>
                    <p class="makeup-quota">@string.Format(L["Checkin_MakeupQuota"], data.MakeupRemaining)</p>
                    @if (!string.IsNullOrEmpty(makeupError))
                    {
                        <p class="makeup-error">@makeupError</p>
                    }
                    <div class="makeup-actions">
                        <button class="btn btn-secondary" @onclick="CloseMakeupDialog">@L["Checkin_Cancel"]</button>
                        <button class="btn btn-primary" @onclick="ConfirmMakeupAsync" disabled="@isMakingUp">@L["Checkin_ConfirmMakeup"]</button>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(makeupToast))
        {
            <div class="makeup-toast">@makeupToast</div>
        }

        <!-- 今日学习清单（按 Learner 分组） -->
        <section class="today-section">
            <h2>@L["Checkin_TodayList"]</h2>

            @if (data.TodayRecords.Count == 0)
            {
                <!-- 空态引导 -->
                <div class="empty-state">
                    <div class="empty-icon">🌱</div>
                    <p class="empty-text">@L["Checkin_EmptyToday"]</p>
                    <a class="cta-btn" href="/daily-card">@L["Checkin_GoDailyCard"]</a>
                </div>
            }
            else
            {
                @foreach (var group in data.TodayRecords.GroupBy(r => r.LearnerName))
                {
                    <div class="learner-group">
                        <div class="group-header">👤 @group.Key <span class="group-count">@group.Count()</span></div>
                        @foreach (var record in group)
                        {
                            <div class="record-item" @onclick="() => ToggleDetail(record)">
                                <span class="rec-status">@(record.IsCompleted ? "✅" : "⏳")</span>
                                <span class="rec-content">@record.Content</span>
                                <span class="rec-time">@(record.Time?.ToString("HH:mm"))</span>
                                <span class="rec-source">@record.Source</span>
                            </div>
                            @if (expandedRecord == record)
                            {
                                <div class="record-detail">
                                    <div class="detail-row"><span>@L["Checkin_Source"]</span><span>@record.Source</span></div>
                                    <div class="detail-row"><span>@L["Checkin_StartTime"]</span><span>@(record.StartTime?.ToString("HH:mm"))</span></div>
                                    <div class="detail-row"><span>@L["Checkin_EndTime"]</span><span>@(record.EndTime?.ToString("HH:mm"))</span></div>
                                    <div class="detail-row"><span>@L["Checkin_CardCount"]</span><span>@record.CardCount</span></div>
                                    <div class="detail-row"><span>@L["Checkin_Accuracy"]</span><span>@record.Accuracy.ToString("F0")%</span></div>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </section>
    }
</div>

<style>
    .checkin-page { max-width: 820px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }

    /* ---------- 连续打卡 ---------- */
    .streak-section {
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
        padding: 1.35rem 1.25rem 1.15rem;
        margin-bottom: 1.5rem;
    }

    .streak-hero {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.15rem 0.6rem;
        text-align: center;
    }

    .streak-flame {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        font-size: 1.5rem;
        background: var(--bh-warning-bg);
        border-radius: 14px;
    }

    .streak-figure { display: inline-flex; align-items: baseline; gap: 0.3rem; }

    .streak-num {
        font-size: 2.15rem;
        font-weight: 750;
        line-height: 1;
        color: var(--bh-warning);
        font-variant-numeric: tabular-nums;
    }

    .streak-unit { font-size: 0.92rem; font-weight: 600; color: var(--bh-ink-500); }

    .streak-grace,
    .streak-motivation {
        flex-basis: 100%;
        margin-top: 0.45rem;
        font-size: 0.86rem;
        color: var(--bh-ink-500);
    }

    .streak-motivation { color: var(--bh-warning); font-weight: 600; }

    /* ---------- 近 7 天日历 ---------- */
    .calendar7 {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.45rem;
        margin-top: 1.15rem;
    }

    .cal-cell {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
        padding: 0.5rem 0 0.45rem;
        background: var(--bh-surface-2);
        border: 1px solid var(--bh-border);
        border-radius: 11px;
        cursor: default;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .cal-date {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--bh-ink-400);
        font-variant-numeric: tabular-nums;
    }

    .cal-mark {
        font-size: 1.1rem;
        line-height: 1.2;
        color: var(--bh-ink-300);
    }

    .cal-cell.checked { background: var(--bh-warning-bg); border-color: #f0dcb4; }
    .cal-cell.checked .cal-date { color: var(--bh-warning); }

    .cal-cell.today {
        border-color: var(--bh-brand-500);
        box-shadow: 0 0 0 3px var(--bh-brand-50);
    }

    .cal-cell.today .cal-date { color: var(--bh-brand-700); }

    .cal-cell.makeupable {
        border-style: dashed;
        border-color: var(--bh-warning);
        cursor: pointer;
    }

    .cal-cell.makeupable:hover { background: var(--bh-warning-bg); transform: translateY(-1px); }

    .cal-makeup-hint {
        position: absolute;
        top: 3px;
        right: 4px;
        font-size: 0.6rem;
        font-weight: 700;
        line-height: 1;
        color: var(--bh-warning);
    }

    /* ---------- 补签弹窗 ---------- */
    .makeup-dialog-mask {
        position: fixed;
        inset: 0;
        background: rgba(16, 34, 45, 0.42);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .makeup-dialog {
        background: var(--bh-surface);
        border-radius: var(--bh-radius-lg);
        padding: 1.4rem 1.5rem;
        min-width: 300px;
        box-shadow: var(--bh-shadow-lg);
    }

    .makeup-dialog h3 { font-size: 1.05rem; font-weight: 650; margin: 0 0 0.4rem; color: var(--bh-ink-900); }
    .makeup-quota { color: var(--bh-ink-500); font-size: 0.88rem; margin-bottom: 0.9rem; }
    .makeup-error { color: var(--bh-danger); font-size: 0.84rem; margin-bottom: 0.75rem; }
    .makeup-actions { display: flex; gap: 0.5rem; justify-content: flex-end; }

    .makeup-toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: var(--bh-ink-900);
        color: #fff;
        padding: 0.55rem 1.1rem;
        border-radius: 10px;
        font-size: 0.86rem;
        box-shadow: var(--bh-shadow-md);
        z-index: 1100;
    }

    /* ---------- 今日清单 ---------- */
    .today-section h2 {
        font-size: 1rem;
        font-weight: 650;
        color: var(--bh-ink-700);
        margin-bottom: 0.7rem;
    }

    .learner-group {
        margin-bottom: 0.85rem;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius);
        padding: 0.7rem 0.9rem;
        box-shadow: var(--bh-shadow-xs);
    }

    .group-header {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--bh-ink-900);
        margin-bottom: 0.4rem;
    }

    .group-count {
        padding: 0 0.4rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--bh-ink-500);
        background: var(--bh-surface-3);
        border-radius: 8px;
    }

    .record-item {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.5rem 0.35rem;
        border-bottom: 1px solid var(--bh-border);
        cursor: pointer;
        border-radius: 8px;
        transition: background 0.14s ease;
    }

    .record-item:hover { background: var(--bh-surface-2); }
    .learner-group .record-item:last-of-type { border-bottom: none; }

    .rec-status { font-size: 0.95rem; }
    .rec-content { flex: 1; min-width: 0; color: var(--bh-ink-700); font-size: 0.9rem; word-break: break-word; }
    .rec-time { color: var(--bh-ink-400); font-size: 0.8rem; font-variant-numeric: tabular-nums; }

    .rec-source {
        padding: 0.12rem 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--bh-success);
        background: var(--bh-success-bg);
        border-radius: 10px;
    }

    .record-detail {
        background: var(--bh-surface-2);
        border-radius: 9px;
        padding: 0.55rem 0.8rem;
        margin: 0.3rem 0 0.5rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.18rem 0;
        font-size: 0.84rem;
        color: var(--bh-ink-500);
    }

    .detail-row span:last-child { color: var(--bh-ink-700); font-weight: 500; }

    /* ---------- 空态 ---------- */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.6rem 1.5rem;
        background: var(--bh-surface-2);
        border: 1.5px dashed var(--bh-border-strong);
        border-radius: var(--bh-radius-lg);
    }

    .empty-icon { font-size: 2.2rem; line-height: 1; margin-bottom: 0.5rem; }
    .empty-text { color: var(--bh-ink-500); font-size: 0.9rem; margin-bottom: 1rem; }

    .cta-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1.15rem;
        background: var(--bh-brand-600);
        color: #fff;
        border-radius: 10px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        box-shadow: var(--bh-shadow-xs);
        transition: background 0.15s ease, transform 0.15s ease;
    }

    .cta-btn:hover { background: var(--bh-brand-700); color: #fff; transform: translateY(-1px); }

    /* ---------- 骨架屏 / 错误 ---------- */
    .loading-skeleton { display: flex; flex-direction: column; gap: 0.75rem; }

    .skeleton {
        background: linear-gradient(90deg, var(--bh-surface-3) 25%, var(--bh-surface-2) 37%, var(--bh-surface-3) 63%);
        background-size: 400% 100%;
        animation: shimmer 1.4s ease infinite;
        border-radius: 8px;
    }

    .skeleton-title { height: 1.9rem; width: 40%; }
    .skeleton-line { height: 1rem; width: 100%; }
    .skeleton-card { height: 5.5rem; width: 100%; }
    @@keyframes shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }

    .checkin-error {
        text-align: center;
        padding: 2.5rem 1rem;
        background: var(--bh-danger-bg);
        border: 1px solid #f2cfcd;
        border-radius: var(--bh-radius-lg);
    }

    .error-text { color: var(--bh-danger); font-size: 0.9rem; margin-bottom: 0.9rem; }

    .retry-btn {
        background: var(--bh-danger);
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 0.45rem 1.2rem;
        cursor: pointer;
        font-size: 0.86rem;
        font-weight: 600;
    }

    /* ---------- 响应式 ---------- */
    @@media (max-width: 768px) {
        .checkin-page { padding: 0.9rem 0.6rem 2rem; }
        .calendar7 { gap: 0.3rem; }
        .cal-cell { padding: 0.4rem 0; }
        .cal-mark { font-size: 0.95rem; }
        .cal-date { font-size: 0.68rem; }
        .streak-num { font-size: 1.8rem; }
        .record-item { flex-wrap: wrap; gap: 0.3rem; }
        .makeup-dialog { min-width: 0; width: calc(100% - 2rem); }
    }
</style>

@code {
    private CheckinDataDto data = new();
    private CheckinRecordDto? expandedRecord;
    private bool isLoading = true;
    private bool loadError = false;

    // FAM-33 补签
    private DateTime? makeupTarget;
    private bool showMakeupDialog = false;
    private bool isMakingUp = false;
    private string makeupError = "";
    private string? makeupToast;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadCheckinAsync();
    }

    private void ToggleDetail(CheckinRecordDto record)
    {
        expandedRecord = expandedRecord == record ? null : record;
    }

    private void TryOpenMakeup(CheckinCalendarDayDto day)
    {
        if (!day.IsMakeupable || !day.Date.HasValue) return;
        makeupTarget = day.Date.Value;
        makeupError = "";
        showMakeupDialog = true;
    }

    private void CloseMakeupDialog()
    {
        showMakeupDialog = false;
        makeupTarget = null;
    }

    private async Task ConfirmMakeupAsync()
    {
        if (!makeupTarget.HasValue || isMakingUp) return;
        isMakingUp = true;
        makeupError = "";
        try
        {
            var vaults = await VaultsService.GetVaultsAsync();
            var vaultId = vaults.Vaults.FirstOrDefault()?.Id;
            var result = await ApiService.MakeupCheckinAsync(new CheckinMakeupRequest
            {
                Date = makeupTarget.Value,
                VaultId = vaultId
            });
            if (result.Success)
            {
                showMakeupDialog = false;
                makeupTarget = null;
                makeupToast = string.Format(L["Checkin_MakeupSuccess"], result.Remaining);
                await LoadCheckinAsync();
                await Task.Delay(2500);
                makeupToast = null;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                makeupError = result.Message;
                if (result.Message.Contains("已用完"))
                {
                    makeupToast = result.Message;
                    await Task.Delay(2500);
                    makeupToast = null;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "补签失败");
            makeupError = L["Checkin_MakeupFailed"].Value;
        }
        finally
        {
            isMakingUp = false;
        }
    }

    private async Task LoadCheckinAsync()
    {
        isLoading = true;
        loadError = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var vaults = await VaultsService.GetVaultsAsync();
            data = await ApiService.GetCheckinDataAsync(vaults.Vaults.FirstOrDefault()?.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载学习打卡页失败");
            loadError = true;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}

