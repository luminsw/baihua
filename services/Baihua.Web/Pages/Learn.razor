@page "/learn"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject Baihua.Web.Services.IApiService ApiService
@inject Microsoft.Extensions.Logging.ILogger<Learn> Logger
@inject IJSRuntime JS
@using Baihua.Contracts.Learn
@using Baihua.Contracts.Achievements

<PageTitle>题库 · 学习</PageTitle>

<div class="learn-page">
    <div class="bh-page-header">
        <div>
            <h1 class="bh-page-title"><span class="bh-page-emoji">📚</span>题库学习</h1>
            <p class="bh-page-sub">按行业选择题库，看题选答案，即时解析与易混淆项区分。</p>
        </div>
    </div>

    @if (stage == Stage.Banks)
    {
        <div class="learn-setup">
            <h2 class="learn-step-title">选择题库</h2>
            @if (banks.Count == 0)
            {
                <p class="learn-empty">暂无可用题库（可以 AI 生成，或导入题库包）。</p>
            }
            else
            {
                <div class="bank-list">
                    @foreach (var bank in banks)
                    {
                        var pendingDelete = pendingDeleteBankCode == bank.BankCode;
                        <div class="bank-card @(pendingDelete ? "pending-delete" : "")">
                            <button class="bank-select btn" @onclick="() => SelectBankAsync(bank)">
                                <div class="bank-name">@bank.IndustryName · @bank.BankName</div>
                                <div class="bank-meta">
                                    <span>@bank.ItemCount 条目</span>
                                    <span>@bank.QuestionCount 道题</span>
                                    <span>v@(string.IsNullOrEmpty(bank.Version) ? "-" : bank.Version)</span>
                                </div>
                            </button>
                            <div class="bank-actions">
                                <a class="btn btn-sm btn-outline-secondary"
                                   href="/api/learn/banks/@Uri.EscapeDataString(bank.BankCode)/export"
                                   title="导出题库包（供花阁/花记）">⬇ 导出</a>
                                <button class="btn btn-sm @(pendingDelete ? "btn-danger" : "btn-outline-danger")"
                                        disabled="@deleting" @onclick="() => DeleteBankAsync(bank)">
                                    @(pendingDelete ? "确认删除" : "🗑 删除")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(bankNotice))
            {
                <div class="bank-notice">@bankNotice</div>
            }
            <div class="export-row">
                <a class="btn btn-primary" href="/learn/generate">✨ AI 生成题库</a>
            </div>
        </div>
    }
    else if (stage == Stage.Learner)
    {
        <div class="learn-setup">
            <h2 class="learn-step-title">选择家庭成员</h2>
            @if (bankStats != null)
            {
                <div class="bank-stats">
                    <div class="stat">
                        <span class="stat-value">@bankStats.Overall.QuestionCount</span>
                        <span class="stat-label">总题数</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@bankStats.Overall.AnsweredCount</span>
                        <span class="stat-label">已刷 @(bankStats.Overall.Coverage)%</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@bankStats.Overall.MasteredCount</span>
                        <span class="stat-label">已掌握</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@bankStats.Overall.WrongCount</span>
                        <span class="stat-label">待复习</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@(bankStats.Overall.Accuracy)%</span>
                        <span class="stat-label">正确率</span>
                    </div>
                    @if (bankStats.Overall.LastAnsweredAt is { } last)
                    {
                        <div class="stat">
                            <span class="stat-value">@last.ToLocalTime().ToString("MM-dd")</span>
                            <span class="stat-label">最近练习</span>
                        </div>
                    }
                </div>
            }
            @if (learners.Count == 0)
            {
                <p class="learn-empty">尚无家庭成员，请先在成就页创建学习者。</p>
            }
            else
            {
                <div class="player-select">
                    @foreach (var l in learners)
                    {
                        <button class="btn @(selectedLearnerId == l.Id ? "btn-primary" : "btn-outline-primary")" @onclick="() => SelectLearnerAsync(l.Id)">
                            <span>@l.AvatarEmoji @l.Name</span>
                            @if (StatsFor(l.Id) is { } s)
                            {
                                <span class="player-stat">已刷 @s.AnsweredCount / @s.QuestionCount · @(s.Accuracy)%</span>
                            }
                        </button>
                    }
                </div>
            }
            <button class="btn btn-link" @onclick="() => BackToBanks()">← 返回题库选择</button>
        </div>
    }
    else if (stage == Stage.Playing && currentQuestion != null)
    {
        <div class="learn-question">
            <div class="learn-progress">
                <span>第 @(index + 1) / @questions.Count 题</span>
                <span>✅ @correctCount　❌ @(answeredCount - correctCount)</span>
            </div>

            <div class="learn-stem">
                <div class="stem-patient">@currentQuestion.StemDetail?.Patient</div>
                <ul class="stem-signs">
                    @foreach (var sign in currentQuestion.StemDetail?.Signs ?? new List<string>())
                    {
                        <li>@sign</li>
                    }
                </ul>
                <div class="stem-full">@currentQuestion.Stem</div>
            </div>

            @if (result == null)
            {
                <div class="learn-options">
                    @foreach (var opt in currentQuestion.Options)
                    {
                        <button class="option-btn btn" @onclick="() => AnswerAsync(opt.Key)">
                            <span class="option-key">@opt.Key</span>
                            <span class="option-content">@opt.Content</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="learn-result @(result.IsCorrect ? "correct" : "wrong")">
                    <div class="result-head">
                        @(result.IsCorrect ? "✅ 答对了" : $"❌ 答错了——正确答案：{result.CorrectKey}．{result.CorrectContent}")
                    </div>
                    <div class="result-options">
                        @foreach (var opt in result.Options)
                        {
                            <div class="result-option @OptionClass(opt)">
                                <span class="option-key">@opt.Key</span>
                                <span>@opt.Content</span>
                                @if (!string.IsNullOrEmpty(opt.Explanation))
                                {
                                    <div class="option-explanation">@opt.Explanation</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="result-analysis">
                        <div class="analysis-title">📖 解析</div>
                        <div class="analysis-body">@currentAnalysis</div>
                    </div>
                    @if ((result.Discrimination?.Count ?? 0) > 0)
                    {
                        <div class="result-discrimination">
                            <div class="analysis-title">🎯 易混淆项 · 关键区分点</div>
                            <table class="table table-sm discrimination-table">
                                <tbody>
                                    @foreach (var d in result.Discrimination!)
                                    {
                                        <tr>
                                            <td class="versus-cell">vs @d.Versus</td>
                                            <td>@d.Point</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="result-actions">
                        @if (isLast)
                        {
                            <button class="btn btn-primary" @onclick="FinishAsync">查看结算 →</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="NextAsync">下一题 →</button>
                        }
                    </div>
                    @if (aiAnalysis == null)
                    {
                        <div class="ai-row">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="RequestAiAnalysisAsync" disabled="@aiLoading">
                                @if (aiLoading)
                                {
                                    <span>AI 分析中…</span>
                                }
                                else
                                {
                                    <span>🤖 AI 延伸分析（可选·由 AI 生成·可能产生费用）</span>
                                }
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="ai-result">
                            <div class="analysis-title">🤖 AI 延伸分析<span class="ai-note">（AI 生成内容，仅供参考）</span></div>
                            <div class="analysis-body">@aiAnalysis</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else if (stage == Stage.Summary)
    {
        <div class="learn-summary">
            <h2>🏁 本轮结算</h2>
            <div class="summary-score">@correctCount / @questions.Count</div>
            <div class="summary-note">正确率 @ScorePercent%，@(wrongCount == 0 ? "全对！" : wrongCount <= 2 ? "表现不错！" : "错题已入回顾，再接再厉！")</div>

            @if (wrongQuestions.Count > 0)
            {
                <h3>错题回顾</h3>
                <div class="wrong-list">
                    @foreach (var w in wrongQuestions)
                    {
                        <div class="wrong-item">
                            <div class="wrong-stem">@w.Question.StemDetail?.Patient</div>
                            <div class="wrong-answer">正确答案：@w.Result.CorrectKey．@w.Result.CorrectContent</div>
                        </div>
                    }
                </div>
                <button class="btn btn-outline-primary" @onclick="RetryWrongAsync">只重做错题</button>
            }
            <div class="summary-actions">
                <button class="btn btn-primary" @onclick="StartOverAsync">再来一轮</button>
                <button class="btn btn-outline-secondary" @onclick="() => BackToBanks()">返回题库选择</button>
            </div>
        </div>
    }
</div>

<style>
    .learn-page { max-width: 880px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }

    .learn-step-title {
        font-size: 1rem;
        font-weight: 650;
        color: var(--bh-ink-700);
        margin: 0.25rem 0 0.9rem;
    }

    /* ---------- 题库卡片 ---------- */
    .bank-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
        gap: 0.75rem;
        margin: 0 0 1rem;
    }

    .bank-card {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.95rem 1.05rem;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius-lg);
        box-shadow: var(--bh-shadow-xs);
        transition: border-color 0.16s ease, box-shadow 0.16s ease, transform 0.16s ease;
    }

    .bank-card:hover {
        border-color: var(--bh-brand-500);
        box-shadow: var(--bh-shadow-md);
        transform: translateY(-1px);
    }

    .bank-card.pending-delete {
        border-color: var(--bh-danger);
        background: var(--bh-danger-bg);
    }

    .bank-select {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: none;
        text-align: left;
        color: inherit;
    }

    .bank-select:hover { background: none; }

    .bank-name {
        font-size: 0.98rem;
        font-weight: 650;
        line-height: 1.4;
        color: var(--bh-ink-900);
        word-break: break-word;
    }

    .bank-select:hover .bank-name { color: var(--bh-brand-700); }

    .bank-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem 0.55rem;
        margin-top: 0.45rem;
        font-size: 0.78rem;
        color: var(--bh-ink-500);
    }

    .bank-meta span {
        padding: 0.1rem 0.45rem;
        background: var(--bh-surface-3);
        border-radius: 6px;
        white-space: nowrap;
    }

    .bank-actions {
        display: flex;
        gap: 0.4rem;
        justify-content: flex-end;
        padding-top: 0.55rem;
        border-top: 1px solid var(--bh-border);
    }

    .bank-actions .btn,
    .export-row .btn {
        padding: 0.2rem 0.6rem;
        font-size: 0.78rem;
        border-radius: 8px;
        white-space: nowrap;
    }

    .bank-notice {
        margin: 0 0 1rem;
        padding: 0.6rem 0.85rem;
        font-size: 0.85rem;
        line-height: 1.6;
        color: var(--bh-warning);
        background: var(--bh-warning-bg);
        border-left: 3px solid var(--bh-warning);
        border-radius: 8px;
        white-space: pre-wrap;
    }

    .export-row { display: flex; gap: 0.5rem; }

    .learn-empty {
        padding: 1.8rem 1rem;
        text-align: center;
        font-size: 0.88rem;
        color: var(--bh-ink-400);
        background: var(--bh-surface-2);
        border: 1.5px dashed var(--bh-border-strong);
        border-radius: var(--bh-radius-lg);
    }

    /* ---------- 统计条 ---------- */
    .bank-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0.5rem 0 1rem;
    }

    .bank-stats .stat {
        min-width: 5.2rem;
        padding: 0.5rem 0.85rem;
        text-align: center;
        background: var(--bh-surface);
        border: 1px solid var(--bh-border);
        border-radius: 10px;
    }

    .bank-stats .stat-value {
        display: block;
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--bh-ink-900);
        font-variant-numeric: tabular-nums;
    }

    .bank-stats .stat-label {
        display: block;
        margin-top: 0.1rem;
        font-size: 0.74rem;
        color: var(--bh-ink-400);
    }

    /* ---------- 成员选择 ---------- */
    .player-select { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1rem; }

    .player-select .btn {
        padding: 0.5rem 0.9rem;
        font-size: 0.88rem;
        border-radius: 10px;
        text-align: left;
    }

    .player-stat { display: block; margin-top: 0.2rem; font-size: 0.74rem; opacity: 0.85; }

    /* ---------- 答题 ---------- */
    .learn-progress {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
        font-size: 0.83rem;
        color: var(--bh-ink-400);
    }

    .learn-stem {
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
        background: var(--bh-surface-2);
        border: 1px solid var(--bh-border);
        border-radius: var(--bh-radius);
        line-height: 1.7;
    }

    .stem-patient { font-weight: 650; color: var(--bh-ink-900); margin-bottom: 0.5rem; }
    .stem-signs { margin: 0 0 0.5rem; padding-left: 1.2rem; }
    .stem-signs li { margin: 0.15rem 0; }
    .stem-full { font-size: 0.86rem; color: var(--bh-ink-500); white-space: pre-wrap; }

    .learn-options { display: flex; flex-direction: column; gap: 0.5rem; }

    .option-btn {
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
        padding: 0.7rem 1rem;
        text-align: left;
        border-radius: 10px;
        line-height: 1.6;
    }

    .option-key { min-width: 1.35rem; font-weight: 700; color: var(--bh-brand-700); }

    .result-head { font-size: 1.05rem; font-weight: 650; margin-bottom: 0.75rem; }
    .learn-result.wrong .result-head { color: var(--bh-danger); }
    .learn-result.correct .result-head { color: var(--bh-success); }

    .result-option { padding: 0.5rem 0.75rem; border-radius: 9px; margin-bottom: 0.4rem; }
    .result-option.right { background: var(--bh-success-bg); border: 1px solid #b9e0ca; }
    .result-option.picked-wrong { background: var(--bh-danger-bg); border: 1px solid #f0cbc9; }
    .result-option.plain { background: var(--bh-surface-2); }

    .option-explanation { margin-top: 0.25rem; font-size: 0.84rem; color: var(--bh-ink-500); }

    .analysis-title { font-weight: 650; margin: 0.9rem 0 0.4rem; color: var(--bh-ink-900); }
    .analysis-body { white-space: pre-wrap; line-height: 1.75; color: var(--bh-ink-700); }
    .discrimination-table .versus-cell { font-weight: 650; white-space: nowrap; }
    .ai-note { font-size: 0.78rem; font-weight: 400; color: var(--bh-ink-400); }

    /* ---------- 结算 ---------- */
    .summary-score {
        font-size: 2.6rem;
        font-weight: 750;
        text-align: center;
        color: var(--bh-brand-700);
        font-variant-numeric: tabular-nums;
    }

    .summary-note { text-align: center; color: var(--bh-ink-500); font-size: 0.88rem; margin-bottom: 1rem; }

    .wrong-item {
        padding: 0.45rem 0.8rem;
        margin: 0.5rem 0;
        border-left: 3px solid var(--bh-danger);
        background: var(--bh-danger-bg);
        border-radius: 0 8px 8px 0;
    }

    .wrong-stem { font-weight: 600; font-size: 0.9rem; color: var(--bh-ink-900); }
    .wrong-answer { font-size: 0.84rem; color: var(--bh-ink-500); }

    .summary-actions, .result-actions, .ai-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
</style>

@code {
    private enum Stage { Banks, Learner, Playing, Summary }

    private Stage stage = Stage.Banks;
    private List<QuizBankOverviewDto> banks = new();
    private List<LearnerDto> learners = new();
    private string selectedBankCode = "";
    private int selectedLearnerId;
    private QuizBankStatsBundleDto? bankStats;
    private string sessionId = Guid.NewGuid().ToString("N")[..12];

    private List<QuizQuestionViewDto> questions = new();
    private List<(QuizQuestionViewDto Question, QuizAnswerResultDto Result)> wrongQuestions = new();
    private int index;
    private QuizQuestionViewDto? currentQuestion;
    private QuizAnswerResultDto? result;
    private string currentAnalysis = "";
    private int correctCount;
    private int answeredCount;
    private bool isLast => index >= questions.Count - 1;
    private int wrongCount => answeredCount - correctCount;
    private int ScorePercent => questions.Count == 0 ? 0 : (int)Math.Round(correctCount * 100.0 / questions.Count);

    private bool aiLoading;
    private string? aiAnalysis;
    private string? pendingDeleteBankCode;
    private bool deleting;
    private string? bankNotice;

    protected override async Task OnInitializedAsync()
    {
        banks = await ApiService.GetLearnBanksAsync();
    }

    private async Task SelectBankAsync(QuizBankOverviewDto bank)
    {
        pendingDeleteBankCode = null;
        bankNotice = null;
        selectedBankCode = bank.BankCode;
        learners = await ApiService.GetLearnersAsync();
        bankStats = await ApiService.GetLearnBankStatsAsync(bank.BankCode);
        stage = Stage.Learner;
    }

    /// <summary>
    /// 删除题库（两步确认：先点「删除」变成「确认删除」，再点才真正删除——全站不用原生 confirm）。
    /// 删除会连条目/题目/答题记录一起清理，因此必须让用户看清将要删掉什么。
    /// </summary>
    private async Task DeleteBankAsync(QuizBankOverviewDto bank)
    {
        if (deleting) return;

        if (pendingDeleteBankCode != bank.BankCode)
        {
            pendingDeleteBankCode = bank.BankCode;
            bankNotice = $"将删除「{bank.IndustryName} · {bank.BankName}」：{bank.ItemCount} 条目、{bank.QuestionCount} 道题，以及这些题的答题记录（不可撤销）。再点一次「确认删除」执行。";
            return;
        }

        deleting = true;
        try
        {
            var result = await ApiService.DeleteLearnBankAsync(bank.BankCode);
            if (result is null)
            {
                bankNotice = "删除失败（后端不可用，或题库已不存在）";
                pendingDeleteBankCode = null;
                return;
            }

            bankNotice = $"已删除「{result.BankName}」：{result.ItemsDeleted} 条目、{result.QuestionsDeleted} 道题、{result.AttemptsDeleted} 条答题记录"
                + (result.IndustryRemoved ? "；该行业下已无题库，行业也一并删除。" : "。");
            pendingDeleteBankCode = null;

            // 刷新题库列表（删除后可能已为空）
            banks = await ApiService.GetLearnBanksAsync();
            if (banks.Count == 0) stage = Stage.Banks;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "删除题库失败：{BankCode}", bank.BankCode);
            bankNotice = "删除失败：" + ex.Message;
        }
        finally
        {
            deleting = false;
        }
    }

    private QuizBankStatsDto? StatsFor(int learnerId) =>
        bankStats?.Learners.FirstOrDefault(s => s.LearnerId == learnerId);

    private async Task SelectLearnerAsync(int learnerId)
    {
        selectedLearnerId = learnerId;
        sessionId = Guid.NewGuid().ToString("N")[..12];
        questions = await ApiService.DrawLearnQuestionsAsync(selectedBankCode, 10);
        index = 0;
        correctCount = 0;
        answeredCount = 0;
        wrongQuestions.Clear();
        stage = questions.Count > 0 ? Stage.Playing : Stage.Banks;
        LoadCurrent();
    }

    private void LoadCurrent()
    {
        currentQuestion = index < questions.Count ? questions[index] : null;
        result = null;
        aiAnalysis = null;
    }

    private async Task AnswerAsync(string key)
    {
        if (currentQuestion == null || result != null) return;
        PickedKey = key;
        var submit = new QuizAnswerSubmitDto
        {
            QuestionCode = currentQuestion.QuestionCode,
            SelectedKey = key,
            LearnerId = selectedLearnerId,
            SessionId = sessionId,
        };
        result = await ApiService.SubmitLearnAnswerAsync(selectedBankCode, submit)
                 ?? new QuizAnswerResultDto { IsCorrect = false, CorrectKey = "?", CorrectContent = "（判定失败：后端不可用）", Options = new List<QuizOptionDto>() };
        currentAnalysis = result.Analysis;
        answeredCount++;
        if (result.IsCorrect) correctCount++;
        else if (currentQuestion != null)
        {
            wrongQuestions.Add((currentQuestion, result));
        }
    }

    private Task NextAsync()
    {
        index++;
        LoadCurrent();
        return Task.CompletedTask;
    }

    private Task FinishAsync()
    {
        stage = Stage.Summary;
        return Task.CompletedTask;
    }

    private async Task RequestAiAnalysisAsync()
    {
        if (currentQuestion == null || result == null || aiLoading) return;
        aiLoading = true;
        try
        {
            var prompt =
                $"我正在做选择题练习，请对下面这题做延伸讲解（核心概念、原理、易错点与记忆要点），帮助我理解记忆：" +
                $"\n\n【题目】{currentQuestion.Stem}" +
                $"\n\n【我的答案】{result.IsCorrect switch { true => "答对了", _ => "答错了" } }，正确答案是 {result.CorrectKey}．{result.CorrectContent}" +
                $"\n\n【标准解析】{currentAnalysis}";
            var chat = await ApiService.ChatAsync(prompt);
            aiAnalysis = chat.Success ? (chat.Reply ?? chat.Message ?? chat.Content) : $"AI 分析失败：{chat.Message}";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI 延伸分析失败");
            aiAnalysis = "AI 分析暂不可用（请检查 AI 配置）。";
        }
        finally
        {
            aiLoading = false;
        }
    }

    private Task RetryWrongAsync()
    {
        questions = wrongQuestions.Select(w => w.Question).ToList();
        wrongQuestions.Clear();
        index = 0;
        correctCount = 0;
        answeredCount = 0;
        stage = Stage.Playing;
        LoadCurrent();
        return Task.CompletedTask;
    }

    private async Task StartOverAsync()
    {
        // 一轮结束回到成员选择：刷新统计，让"已刷/正确率"反映刚才这轮
        bankStats = await ApiService.GetLearnBankStatsAsync(selectedBankCode);
        stage = Stage.Learner;
    }

    private async Task BackToBanks()
    {
        // 回到题库选择时刷新列表：其它标签页可能刚生成/删除了题库
        banks = await ApiService.GetLearnBanksAsync();
        stage = Stage.Banks;
    }

    private string OptionClass(QuizOptionDto opt) => opt.IsCorrect ? "right"
        : (result != null && opt.Key == PickedKey ? "picked-wrong" : "plain");

    private string? PickedKey { get; set; }
}
