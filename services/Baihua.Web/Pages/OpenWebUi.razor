@page "/open-webui"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Baihua.Web.Localization.SharedResources> L
@inject IConfiguration Configuration

<PageTitle>@L["OpenWebUi_PageTitle"]</PageTitle>

<div class="container-fluid open-webui-app" style="height: calc(100vh - 120px); display: flex; flex-direction: column;">

    <div class="row mb-2 align-items-center">
        <div class="col-auto">
            <h4 class="mb-0"><i class="bi bi-chat-dots"></i> @L["OpenWebUi_Title"]</h4>
        </div>
        <div class="col text-end">
            <a class="btn btn-sm btn-outline-primary" href="@_url" target="_blank" rel="noopener">↗ @L["OpenWebUi_OpenExternal"]</a>
        </div>
    </div>

    <div class="open-webui-frame-wrap flex-grow-1" style="min-height: 0;">
        <iframe class="open-webui-frame" src="@_url" title="Open WebUI"
                allow="clipboard-write; clipboard-read; fullscreen" allowfullscreen></iframe>
    </div>
</div>

<style>
    .open-webui-frame-wrap { border: 1px solid rgba(128,128,128,0.25); border-radius: 8px; overflow: hidden; }
    [data-bs-theme="dark"] .open-webui-frame-wrap { border-color: rgba(255,255,255,0.15); }
    .open-webui-frame { width: 100%; height: 100%; border: 0; display: block; background: #fff; }
</style>

@code {
    private string _url = "";

    protected override Task OnInitializedAsync()
    {
        _url = (Configuration["OpenWebUi:BaseUrl"] ?? "http://localhost:8080").TrimEnd('/') + "/";
        return Task.CompletedTask;
    }
}
